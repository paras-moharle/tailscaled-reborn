#!/system/bin/sh
# tailscaled.update — keep the tailscaled binary current.
#
# Why this exists
# ---------------
# The tailscaled we ship is a static binary; it never updates itself, so an
# installed module slowly falls behind and Tailscale's own health check nags
# about it ("This machine is N versions out of date").
#
# Rather than reimplementing a downloader in shell, this drives the updater
# that is compiled INTO our tailscaled build. That matters for two reasons:
#
#   1. It is written in Go, so it verifies TLS certificates. On a rooted phone
#      there is no other TLS-capable HTTP client — busybox wget on a stock
#      kernel is built without CA validation, so a shell downloader would be
#      trivially interceptable.
#   2. It already knows our release layout and installs atomically
#      (writes tailscaled.new, then renames over the running binary).
#
# What this script adds on top: scheduling, supervision and rollback. If the
# daemon does not come back healthy after an update, we put the previous
# binary back.
#
# Commands:
#   tailscaled.update status     current + latest version, last check, backup
#   tailscaled.update check      query for updates (rate limited)
#   tailscaled.update run        update now if newer (ignores the interval)
#   tailscaled.update rollback   restore the previous binary
#
# @title Tailscaled Auto-Updater
# @cmd status | Show current version, latest available, last check, backup
# @cmd check | Check for a newer binary (rate limited)
# @cmd run | Update now if a newer binary exists
# @cmd rollback | Restore the previous binary
set -e
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh

# settings.sh defines these, but a stale settings.sh from an older module
# version would silently resolve paths against "/" — so pin them here.
TS_DIR="${TS_DIR:-/data/adb/tailscale}"
TS_BIN_DIR="${TS_BIN_DIR:-${TS_DIR}/bin}"
TS_RUN_DIR="${TS_RUN_DIR:-${TS_DIR}/run}"

BACKUP="${TS_BIN_DIR}/tailscaled.prev"
SETTLE_MARK="${TS_RUN_DIR}/update-settling"
STAMP_FILE="${TS_RUN_DIR}/last_update_check"
STATE="${TS_RUN_DIR}/update.state"

# Copy the binary that is about to be replaced, so a failed update has a way
# back. Always refreshed immediately before an update, so BACKUP is always
# exactly the version we are moving away from.
snapshot() {
	[ -f "${TS_BIN_DIR}/tailscaled" ] || return 0
	cp -f "${TS_BIN_DIR}/tailscaled" "$BACKUP" 2>/dev/null || true
	chmod 0755 "$BACKUP" 2>/dev/null || true
}

current_version() { tailscaled --version 2>/dev/null | head -1 | tr -d ' \r'; }
backup_version() { "$BACKUP" --version 2>/dev/null | head -1 | tr -d ' \r'; }

# version_is_newer <a> <b> -- true when <a> is strictly newer than <b>.
#
# Read that carefully: the FIRST argument is the one being tested. Every call
# site below wants "is the published version newer than what is installed?", so
# it passes the published version first. Getting that backwards is invisible
# while installed == published, which is exactly the state the updater spends
# all its time in -- and catastrophic the day they differ, because it would
# report a newer release as up to date, and downgrade a phone whose feed moved
# backwards.
version_is_newer() {
	[ -n "$1" ] && [ -n "$2" ] || return 1
	[ "$1" != "$2" ] || return 1
	_i=1
	while [ "$_i" -le 3 ]; do
		_a=$(echo "$1" | cut -d. -f"$_i" | tr -dc '0-9')
		_b=$(echo "$2" | cut -d. -f"$_i" | tr -dc '0-9')
		_a=${_a:-0}
		_b=${_b:-0}
		[ "$_a" -gt "$_b" ] 2>/dev/null && return 0
		[ "$_b" -gt "$_a" ] 2>/dev/null && return 1
		_i=$((_i + 1))
	done
	return 1
}

# up_to_date — true when nothing newer is published.
#
# Uses the release-asset feed (settings.sh: TS_LATEST_URL) rather than
# `tailscale update --dry-run`, because the latter hits api.github.com, which
# is limited to 60 requests/hour per IP. Phones are usually behind CGNAT where
# that limit is shared with many other users, so it is routinely exhausted.
up_to_date() {
	_lv="$(latest_version 2>/dev/null || true)"
	if [ -n "$_lv" ]; then
		version_is_newer "$_lv" "$(current_version)" || return 0

		# Newer exists, but hold it back until it has had time to settle, so a
		# bad release is not pushed to every phone the moment CI publishes it.
		_pa="$(latest_published_epoch 2>/dev/null || true)"
		case "$_pa" in
		'' | *[!0-9]*) : ;;
		*)
			_age=$(( $(date +%s) - _pa ))
			if [ "$_age" -lt "$((TS_UPDATE_SETTLE_HOURS * 3600))" ]; then
				[ -f "$SETTLE_MARK" ] || {
					printf '%s\n' "$_lv published ${_age}s ago; holding for ${TS_UPDATE_SETTLE_HOURS}h" \
						> "$SETTLE_MARK"
				}
				return 0
			fi
			;;
		esac
		return 1
	fi
	# Feed unreachable — fall back to the binary's own check.
	case "$(timeout 60 tailscale update --dry-run 2>&1)" in
	*"no update needed"* | *"already running"*) return 0 ;;
	esac
	return 1
}

touch_stamp() { date +%s >"$STAMP_FILE" 2>/dev/null || true; }

# due — true when the interval has elapsed (or we have never checked).
due() {
	[ "${TS_UPDATE_AUTO}" = true ] || return 0
	[ -f "$STAMP_FILE" ] || return 0
	_now=$(date +%s)
	_then=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
	[ "$_now" -ge $((_then + TS_UPDATE_INTERVAL_HOURS * 3600)) ]
}

healthy() {
	[ "$(timeout 10 tailscale status --json 2>/dev/null | jq -r '.BackendState // empty')" = "Running" ]
}

write_state() { echo "$1" >"$STATE" 2>/dev/null || true; }

humanise_since() {
	[ -f "$STAMP_FILE" ] || {
		echo "never"
		return
	}
	_then=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
	_d=$((($(date +%s) - _then) / 3600))
	if [ "$_d" -lt 1 ]; then echo "less than an hour ago"; else echo "${_d}h ago"; fi
}

# ------------------------------------------------------------------ status --
cmd_status() {
	_cur="$(current_version)"
	printf '%s\n' "${blue}Tailscaled Updater${normal}"
	printf '  %sRepository  %s%s\n' "$blue" "${TS_UPDATE_REPO}" "$normal"
	printf '  %sAuto        %s (every %sh)%s\n' "$blue" "${TS_UPDATE_AUTO}" "$TS_UPDATE_INTERVAL_HOURS" "$normal"
	printf '  %sInstalled   %s%s\n' "$blue" "${_cur:-unknown}" "$normal"
	printf '  %sLast check  %s%s\n' "$blue" "$(humanise_since)" "$normal"
	if [ -f "$BACKUP" ]; then
		printf '  %sBackup      %s (%s)%s\n' "$blue" "$BACKUP" "$(backup_version)" "$normal"
	else
		printf '  %sBackup      %snone%s\n' "$blue" "$normal" "$normal"
	fi

	_lv="$(latest_version 2>/dev/null || true)"
	if [ -n "$_lv" ]; then
		if version_is_newer "$_lv" "$_cur"; then
			printf '  %sLatest      %s%s available%s\n' "$blue" "$yellow" "$_lv" "$normal"
		else
			printf '  %sLatest      %sup to date%s\n' "$blue" "$green" "$normal"
		fi
	elif _dry="$(timeout 60 tailscale update --dry-run 2>&1)"; then
		case "$_dry" in
		*"no update needed"* | *"already running"*) printf '  %sLatest      %sup to date%s\n' "$blue" "$green" "$normal" ;;
		*) printf '  %sLatest      %supdate available%s\n' "$blue" "$yellow" "$normal" ;;
		esac
	else
		printf '  %sLatest      %scould not reach release feed%s\n' "$blue" "$red" "$normal"
	fi
}

# ------------------------------------------------------------------- check --
cmd_check() {
	touch_stamp
	if _lv="$(latest_version 2>/dev/null || true)"; then :; fi
	if [ -n "$_lv" ]; then
		case "$(version_is_newer "$_lv" "$(current_version)" && echo newer)" in
		newer)
			write_state "update-available"
			printf '%s\n' "${yellow}tailscaled ${_lv} is available (installed: $(current_version))${normal}"
			;;
		*)
			write_state "ok-$(current_version)"
			printf '%s\n' "${green}tailscaled is up to date ($(current_version))${normal}"
			;;
		esac
		return 0
	fi

	# Feed unreachable; fall back to the binary's own check (rate limited).
	if _dry="$(timeout 60 tailscale update --dry-run 2>&1)"; then
		case "$_dry" in
		*"no update needed"* | *"already running"*)
			write_state "ok-$(current_version)"
			printf '%s\n' "${green}tailscaled is up to date${normal}"
			;;
		*403* | *"rate limit"*)
			write_state "ratelimited"
			printf '%s\n' "${yellow}GitHub rate limit reached; will retry later.${normal}"
			;;
		*)
			write_state "update-available"
			printf '%s\n' "${yellow}An update is available: ${_dry}${normal}"
			;;
		esac
	else
		write_state "feed-unreachable"
		printf '%s\n' "${yellow}Could not reach the release feed; will retry later.${normal}"
	fi
}

# --------------------------------------------------------------------- run --
#
# The daemon must be running when any of this returns.
#
# An update that fails is not a rare thing: the feed can be unreachable, the
# download can be cut short, the write can fail. What is not acceptable is an
# update that leaves the phone with no daemon -- the symptom of which is the
# app reporting a refused socket, with nothing in any log to say the update
# was the reason. On a device this happened to, the update failed at boot and
# the daemon never came up again until the next reboot.
ensure_daemon_running() {
	if busybox pgrep -f 'tailscaled -no-logs' >/dev/null 2>&1; then
		return 0
	fi
	log Warning "The daemon is not running; starting it."
	"${TS_SCRIPTS_DIR}/tailscaled.service" start >>"${TS_RUN_LOG_FILE}" 2>&1 || true
	sleep 3
	if busybox pgrep -f 'tailscaled -no-logs' >/dev/null 2>&1; then
		log Info "The daemon is running again."
		return 0
	fi
	log Error "The daemon could not be started. Check: tailscaled.service log daemon"
	return 1
}

cmd_run() {
	touch_stamp
	_cur="$(current_version)"

	if up_to_date; then
		write_state "ok-${_cur}"
		return 0
	fi

	log Info "Updating tailscaled (${_cur})..."
	snapshot

	if ! _fetch_new_binary; then
		log Error "Could not obtain the new binary; keeping ${_cur}."
		write_state "failed-update"
		ensure_daemon_running || true
		return 1
	fi

	# Replace it. `cp` onto the running inode is fine on Linux; the daemon is
	# restarted immediately afterwards either way.
	if ! cp -f "${dl_work}/tailscaled" "${TS_BIN_DIR}/tailscaled" 2>/dev/null; then
		log Error "Could not write the new binary; keeping ${_cur}."
		write_state "failed-update"
		ensure_daemon_running || true
		return 1
	fi
	rm -rf "$dl_work"

	# The updater renames over the binary; make sure it is still sane.
	if [ ! -x "${TS_BIN_DIR}/tailscaled" ]; then
		log Error "tailscaled missing after update; rolling back."
		cmd_rollback
		write_state "rolled-back"
		ensure_daemon_running || true
		return 1
	fi
	chmod 0755 "${TS_BIN_DIR}/tailscaled" 2>/dev/null || true
	# Upstream may have left `tailscale` pointing at the replaced inode.
	ensure_cli_symlink

	_new="$(current_version)"
	if [ -z "$_new" ]; then
		log Error "tailscaled will not report a version after update; rolling back."
		cmd_rollback
		write_state "rolled-back"
		ensure_daemon_running || true
		return 1
	fi

	tailscaled.service restart >/dev/null 2>&1 || true
	sleep 8

	if ! healthy; then
		log Error "Daemon unhealthy after update to ${_new}; rolling back."
		cmd_rollback
		write_state "rolled-back"
		ensure_daemon_running || true
		return 1
	fi

	log Success "tailscaled updated: ${_cur} -> ${_new}"
	write_state "ok-${_new}"
	# Keep the snapshot: it is now the previous version, which is exactly what
	# `tailscaled.update rollback` should restore.
	return 0
}


# ----------------------------------------------------------------- download --
#
# `tailscale update --yes` is deliberately not used to install.
#
# That command talks to a URL baked into the binary at compile time, pointing
# at /releases/latest of whichever repository was configured at build time. This
# repo publishes two kinds of release -- flashable module zips and daemon builds
# -- so "latest" is whichever was published last, and the daemon build lives in
# a different repository entirely. It reported success and installed nothing.
#
# The feed already names the release and the repository, so we fetch exactly
# that: a plain HTTPS GET of a release asset, which is a redirect and not a
# rate-limited API call.
dl_work="${TS_DIR}/update-dl"

_fetch_new_binary() {
	# settings.sh and this file run under `set -e`, and every non-zero exit in
	# this function is ordinary: an unreachable feed, a missing checksum entry,
	# a `grep` that matched nothing. Any one of them would abort the update
	# silently, leaving the phone on whatever it had.
	set +e

	_tag="$(latest_release_tag)"
	_repo="$(latest_repo)"
	_ver="$(latest_version)"
	_arch="$(uname -m)"
	case "$_arch" in
	aarch64 | arm64) _arch="arm64" ;;
	armv7l | arm) _arch="arm" ;;
	esac

	if [ -z "$_tag" ] || [ -z "$_ver" ]; then
		log Error "Feed does not name a release to install (tag='${_tag}' version='${_ver}')."
		return 1
	fi
	[ -n "$_repo" ] || _repo="${TS_UPDATE_REPO}"

	_asset="tailscale_${_ver}_${_arch}.tgz"
	_url="https://github.com/${_repo}/releases/download/${_tag}/${_asset}"

	rm -rf "$dl_work"
	mkdir -p "$dl_work" || return 1
	log Info "Downloading ${_asset}"

	if ! ts_fetch "$_url" > "${dl_work}/bin.tgz" 2>/dev/null; then
		# ts_fetch returns text, so a binary needs the raw path.
		if ! timeout 300 busybox wget -q -O "${dl_work}/bin.tgz" "$_url"; then
			log Error "Download failed: ${_url}"
			return 1
		fi
	fi

	[ -s "${dl_work}/bin.tgz" ] || { log Error "Downloaded archive is empty."; return 1; }

	# SHA256SUMS ships beside the assets. Verify before installing anything:
	# a truncated or corrupted binary that is only discovered after it has
	# replaced a working daemon is a bad afternoon.
	_sum_url="https://github.com/${_repo}/releases/download/${_tag}/SHA256SUMS"
	if timeout 60 busybox wget -q -O "${dl_work}/SHA256SUMS" "$_sum_url" 2>/dev/null; then
		_want="$(grep " ${_asset}\$" "${dl_work}/SHA256SUMS" 2>/dev/null | head -1 | awk '{print $1}')"
		if [ -n "$_want" ]; then
			_got="$(sha256sum "${dl_work}/bin.tgz" 2>/dev/null | awk '{print $1}')"
			if [ -n "$_got" ] && [ "$_got" != "$_want" ]; then
				log Error "Checksum mismatch for ${_asset}; refusing to install."
				return 1
			fi
			log Info "Checksum verified."
		else
			log Warning "No checksum listed for ${_asset}; installing without verification."
		fi
	else
		log Warning "SHA256SUMS unavailable; installing without verification."
	fi

	if ! tar -xzf "${dl_work}/bin.tgz" -C "$dl_work" 2>/dev/null; then
		log Error "Could not extract ${_asset}."
		return 1
	fi
	[ -f "${dl_work}/tailscaled" ] || { log Error "Archive did not contain tailscaled."; return 1; }

	# The daemon must at least be able to run here.
	chmod 0755 "${dl_work}/tailscaled" 2>/dev/null || true
	if ! "${dl_work}/tailscaled" --version >/dev/null 2>&1; then
		log Error "Downloaded tailscaled will not execute on this device."
		return 1
	fi
	return 0
}

# ---------------------------------------------------------------- rollback --
cmd_rollback() {
	if [ ! -f "$BACKUP" ]; then
		log Error "No backup binary to roll back to."
		return 1
	fi
	_old="$(backup_version)"
	log Warning "Rolling back to ${_old}"
	cp -f "$BACKUP" "${TS_BIN_DIR}/tailscaled"
	chmod 0755 "${TS_BIN_DIR}/tailscaled"
	chown 0:0 "${TS_BIN_DIR}/tailscaled" 2>/dev/null || true
	ensure_cli_symlink
	tailscaled.service restart >/dev/null 2>&1 || true
	sleep 6
	if healthy; then
		log Success "Rollback complete; running ${_old}"
		return 0
	fi
	log Error "Still unhealthy after rollback."
	log Error "Inspect with: tailscaled.service log daemon"
	# Even a failed rollback must not be the reason the phone has no daemon.
	ensure_daemon_running || true
	return 1
}

case "$1" in
status) cmd_status ;;
check)
	due || {
		printf '%s\n' "${normal}(skipped; checked less than ${TS_UPDATE_INTERVAL_HOURS}h ago)${normal}"
		exit 0
	}
	cmd_check
	;;
run) cmd_run ;;
rollback) cmd_rollback ;;
*)
	echo "${yellow}usage:${normal} tailscaled.update {${orange}status${normal}|${orange}check${normal}|${orange}run${normal}|${orange}rollback${normal}}"
	;;
esac