#!/system/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 paras-moharle
#
# tailscaled.receive — pull Taildrop deliveries onto the phone and notify.
#
# Taildrop is push on the sender and pull on the receiver. `tailscale file cp`
# drops a file into the phone's inbox and returns; unless something pulls it,
# the sender is told it worked and the file goes nowhere. The app can pull it by
# hand, but that only helps if the app happens to be open.
#
# This runs alongside the daemon and pulls automatically:
#
#   file get --wait  blocks until something arrives, so this is event-driven
#                    rather than a poll. It is also what makes the notification
#                    timely -- there is no interval to be late by.
#
# Deliveries are copied into Downloads/Tailscale so they appear in the Files app,
# and are notified by name. A second copy is kept in the inbox because tailscale
# refuses to overwrite: sending the same filename twice must not silently drop
# the newer file.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh

# settings.sh runs under `set -e`. This is a long-lived loop whose every
# non-zero exit is ordinary: killing a stale pid, an inbox with nothing in it,
# a `[ ]` test that is false. Any of those would tear the receiver down and
# silently stop delivery notification, which is the one thing it exists to do.
set +e

INBOX="${TS_DIR}/inbox"
DEST="${TS_TAILDROP_DIR}"
# Where this daemon actually puts received files.
#
# `tailscale file get` used to copy deliveries out of a root-only inbox, which
# is what this receiver watched. It no longer does that: the daemon delivers
# straight into a per-user Downloads/Taildrop folder and leaves nothing to pull.
# So the pull below finds an empty inbox while files pile up in a folder nobody
# was watching -- every send "succeeded", nothing was announced, and the files
# looked lost. Watch the delivery folder as well as the inbox.
DROP_DIR="${TS_DROP_DIR:-/sdcard/Download/Taildrop}"

# Names already announced, kept across restarts.
#
# Comparing against a per-cycle listing meant anything that arrived while the
# receiver was not running was, on the next start, simply part of the listing
# and therefore old -- so it was never announced. A restart silently swallowed
# every delivery that landed during it. This file is the memory that stops that.
_STUCK_FILE="${TS_RUN_DIR}/stuck.list"
PIDFILE="${TS_RUN_DIR}/receive.pid"
NOTIFY_CHANNEL="taildrop"

log_line() {
	printf '%s [Receive] %s\n' "$(date '+%F %T')" "$1" >> "${TS_RUN_LOG_FILE}"
}

# Notify by name. `cmd notification` exists on every Android 6+ device and needs
# no app to be running, which is exactly what a background arrival requires.
notify() {
	# $1 = count, $2 = names. Hands the delivery to TailBridge, which can post
	# a real notification with an "Open folder" button.
	#
	# `cmd notification post` was tried first and is not enough: it returns
	# success but only creates a transient shell channel, so the alert is not in
	# the shade afterwards and it cannot carry an action at all. An explicit
	# broadcast to the app's own receiver is the only route to a notification
	# that survives and can be tapped.
	count="$1"
	names="$2"
	first="${3:-}"
	[ "$count" -gt 0 ] || return 0
	am broadcast \
		-n "com.paras.tailbridge/.ReceiveNotifier" \
		-a "com.paras.tailbridge.RECEIVED" \
		--ei count "$count" \
		--es names "$names" \
		--es first "$first" \
		--es dir "$DEST" >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		# TailBridge absent or refusing. Still tell the user somehow.
		cmd notification post -t "Taildrop: $count file(s)" \
			-s "$NOTIFY_CHANNEL" "tag" "taildrop" \
			"Taildrop: $count file(s)" "$names" >/dev/null 2>&1
	fi
}

copy_out() {
	# $1 = received file. Move it out of where it was delivered and into DEST.
	#
	# A move, not a copy, and that is the point. Leaving the delivered file in
	# place is what let stale files pile up in the delivery folder for ever --
	# and because the daemon refuses to overwrite a name that already exists
	# there, a leftover did not merely go unannounced, it blocked every later
	# delivery of that same filename from ever arriving. Both directories are
	# on the same filesystem, so this is a rename.
	[ -f "$1" ] || return 1
	name="$(basename "$1")"
	mkdir -p "$DEST" 2>/dev/null || return 1
	target="${DEST}/${name}"
	# The destination may hold a file the user has since moved or edited. That
	# one must never be clobbered.
	if [ -e "$target" ]; then
		# Split the extension off the end, keeping compound suffixes whole.
		# Splitting on the last dot alone turned "photos.tar.gz" into
		# "photos.tar-1.gz", which is not a name anybody has.
		ext=""
		stem="$name"
		for _c in .tar.gz .tar.bz2 .tar.xz .tar.zst; do
			case "$name" in
				*"$_c")
					ext="$_c"
					stem="${name%"$_c"}"
					break
					;;
			esac
		done
		if [ -z "$ext" ]; then
			case "$name" in
				*.*)
					ext=".${name##*.}"
					stem="${name%.*}"
					;;
			esac
		fi
		# A dotfile such as ".gitignore" is all extension and no stem; it is
		# one name, and numbering it must not produce "-1.gitignore".
		[ -z "$stem" ] && { stem="$name"; ext=""; }
		n=1
		while [ -e "${DEST}/${stem}-${n}${ext}" ]; do
			n=$((n + 1))
		done
		target="${DEST}/${stem}-${n}${ext}"
	fi
	mv -f "$1" "$target" 2>/dev/null || return 1
	log_line "exported ${target}"
	echo "$target"
}

# A clipboard file that arrived from a peer.
#
# The file is named "clip-*.clip" and starts with a magic line, so it cannot
# be confused with an ordinary file the user sent. It is put into the
# clipboard and recorded in the history, which is what makes the clipboard
# follow the phone around rather than just being readable on it.
#
# The helper runs as the shell uid. Running it as root would make the
# clipboard service clear the user's clipboard instead of setting it: the
# service checks that the calling process owns the package it claims to be,
# and root does not own com.android.shell.
handle_clip() {
	_file="$1"
	base="$(basename "$_file")"
	case "$base" in
	clip-*.clip) ;;
	*) return 0 ;;
	esac

	# The magic line has to be there. A file that merely ends in .clip is an
	# ordinary file and is left alone.
	_magic="$(head -1 "$_file" 2>/dev/null)"
	[ "$_magic" = "TBCLIP1" ] || return 0

	_meta="$(sed -n '2p' "$_file" 2>/dev/null)"
	_b64="$(tail -n +3 "$_file" 2>/dev/null | tr -d '\n')"
	[ -n "$_b64" ] || return 0

	_text="$("${TS_BIN_DIR}/jq" -R -r '@base64d' <<EOF 2>/dev/null
$_b64
EOF
)"
	[ -n "$_text" ] || return 0

	_src="$("${TS_BIN_DIR}/jq" -r '.s // ""' <<EOF 2>/dev/null
$_meta
EOF
)"

	# Put it in the clipboard.
	ensure_clip_dex >/dev/null 2>&1
	if su 2000 -c "CLASSPATH='${TS_CLIP_DEX_RUN:-/data/local/tmp/tailbridge-clip.dex}' app_process /system/bin ${TS_CLIP_CLASS:-com.paras.tailbridge.clip.ClipBoard} set com.android.shell" \
		> /dev/null 2>&1 <<EOF
$_b64
EOF
	then
		log_line "clipboard received from ${_src:-a peer}"
	else
		log_line "clipboard arrived but could not be set"
		return 0
	fi

	# Record it, so the history on this device knows about it too.
	#
	# The watcher also sees the clipboard change this just made, and records
	# it -- without knowing where it came from. So the entry written here
	# replaces a matching one rather than adding a second, and it is the one
	# that survives: it knows the text came from a peer and which peer.
	#
	# -c: one entry per line, like the watcher writes them.
	#
	# The text is encrypted here too, with the same key and the same
	# helper, so the whole history is ciphertext on disk and not just the
	# part of it this device copied itself.
	_store="${TS_CLIP_STORE:-${TS_DIR}/clipboard.jsonl}"
	_json="$(printf '%s' "$_b64" | clip_crypto seal "${_src:-}" 1 2>/dev/null)"
	_h=""
	if [ -n "$_json" ]; then
		_h="$(printf '%s' "$_json" | "${TS_BIN_DIR}/jq" -r '.h // ""' 2>/dev/null)"
	else
		# No keystore here. The text is written as it is, and the
		# watcher says out loud that the history is not encrypted.
		_h="plain:$(printf '%s' "$_b64" | sha256sum 2>/dev/null | cut -d" " -f1)"
		_json="$("${TS_BIN_DIR}/jq" -c -n \
			--argjson t "$(busybox date +%s 2>/dev/null || echo 0)000" \
			--arg c "$_b64" \
			--arg s "${_src:-}" \
			--arg h "$_h" \
			'{t:$t,c:$c,s:$s,d:1,p:0,h:$h}' 2>/dev/null)"
	fi
	[ -n "$_json" ] || return 0

	_last_h=""
	if [ -f "$_store" ]; then
		_last_h="$(tail -n 1 "$_store" 2>/dev/null |
			"${TS_BIN_DIR}/jq" -r '.h // ""' 2>/dev/null)"
	fi
	if [ -n "$_last_h" ] && [ "$_last_h" = "$_h" ]; then
		_tmp="${_store}.tmp.$$"
		if sed '$d' "$_store" > "$_tmp" 2>/dev/null; then
			printf '%s\n' "$_json" >> "$_tmp" 2>/dev/null
			mv -f "$_tmp" "$_store" 2>/dev/null || rm -f "$_tmp" 2>/dev/null
		else
			rm -f "$_tmp" 2>/dev/null
			printf '%s\n' "$_json" >> "$_store" 2>/dev/null
		fi
		return 0
	fi
	printf '%s\n' "$_json" >> "$_store" 2>/dev/null
	return 0
}

# A file we could not move out. Said once, not once per poll.
note_stuck() {
	_f="$1"
	_k="$_STUCK_FILE	$(basename "$_f")"
	if [ -f "$_STUCK_FILE" ] &&
		printf '%s\n' "$_k" | grep -Fxq -f "$_STUCK_FILE" 2>/dev/null; then
		return 0
	fi
	printf '%s\n' "$_k" >> "$_STUCK_FILE" 2>/dev/null || true
	log_line "could not export $(basename "$_f"); still in $(dirname "$_f")"
	notify 1 "$(basename "$_f")" ""
}

drain() {
	# Two places can hold a delivery, and which one is used depends on the
	# daemon version:
	#
	#   INBOX     `tailscale file get` copied deliveries here on older builds.
	#   DROP_DIR  the daemon delivers here directly on current ones.
	#
	# Both are swept so a daemon update cannot silently stop every notification
	# while sends keep reporting success.
	#
	# Neither is a queue: the pull does not remove what it copied, and the
	# daemon leaves what it delivered. So each directory is snapshotted first and
	# No seen-list is needed, and keeping one is what broke resending: see the
	# comment on sweep(). A file is unhandled exactly while it is still in the
	# directory, and this loop moves it out.
	mkdir -p "$INBOX" 2>/dev/null
	chmod 0700 "$INBOX" 2>/dev/null

	if [ -d "$DROP_DIR" ]; then
		# Daemon-owned: only we may write here.
		chmod 0771 "$DROP_DIR" 2>/dev/null
	fi

	# Kept for older daemons. Harmless and near-free on a current one.
	timeout 60 "$TS_CLI" file get --conflict=rename "$INBOX" >/dev/null 2>&1

	names=""
	exported=""
	first=""
	count=0

	# $1 = directory.
	#
	# Presence in the directory is the whole test. This receiver moves each
	# file out as it exports it, so anything still sitting here has not been
	# delivered yet, and there is nothing else to decide.
	#
	# It used to keep a seen-list of names already handled, and that was
	# wrong in three separate ways:
	#
	#   - keyed on the name, so every later delivery of a filename that had
	#     been seen once was skipped forever. Sending the same file twice
	#     simply stopped working: the daemon delivered it, the receiver
	#     ignored it, and it sat in the folder with no export and no alert.
	#   - a snapshot taken per cycle misses anything that arrived between one
	#     sweep and the next cycle's snapshot, which is every arrival, always.
	#   - adding size and mtime did not fix it either, because re-sending the
	#     same file produces the same bytes with the same timestamp. The file
	#     was genuinely new and was still called "already seen".
	#
	# The daemon will not overwrite a name that is already present in the
	# delivery folder; it holds the file until the name is free. So a file
	# left behind there does not merely go unannounced, it also blocks the
	# next delivery of that name from ever arriving.
	sweep() {
		_dir="$1"
		[ -d "$_dir" ] || return 0
		for f in "$_dir"/*; do
			[ -f "$f" ] || continue
			base="$(basename "$f")"
			# A file the daemon is still writing is named
			# "<name>.<sender-node-id>[-n].partial". Exporting it announces a
			# truncated transfer as though it were the file: a 140 MB folder
			# whose send was cut off arrived as two 42 MB files with the
			# sender's node ID in the name and a notification saying they had
			# been received. The daemon writes the real name when the transfer
			# completes, so these are left where they are and ignored.
			case "$base" in
				*.partial) continue ;;
			esac
			out="$(copy_out "$f")"
			if [ -z "$out" ]; then
				# Could not move it out. Leave it and say so once, rather
				# than repeating the same complaint every few seconds.
				note_stuck "$f"
				continue
			fi
			count=$((count + 1))
			names="${names}${names:+, }$base"
			exported="${exported}${exported:+, }$(basename "$out")"
			[ -n "$first" ] || first="$out"
			# A clipboard file is also put into the clipboard and recorded.
			handle_clip "$out"
		done
	}

	sweep "$INBOX"
	sweep "$DROP_DIR"

	if [ "$count" -gt 0 ]; then
		log_line "received ${count}: ${names}"
		# `cmd notification post` only creates a transient shell channel: it
		# returns success but does not survive in the notification shade. So
		# the durable record is this file, which the app reads and shows the
		# next time it is opened -- the notification is a best-effort nudge.
		{
			printf 'at=%s\n' "$(date +%s)"
			printf 'count=%s\n' "$count"
			printf 'names=%s\n' "$names"
			printf 'dir=%s\n' "$DEST"
		} > "${TS_RUN_DIR}/last-received" 2>/dev/null || true
		if [ -n "$exported" ]; then
			notify "$count" "$exported" "$first"
		else
			notify "$count" "$names" ""
		fi
	fi
	[ "$count" -gt 0 ]
}

# Consecutive failures. A daemon restart looks like one failure; a genuinely
# broken CLI looks like several. Quiet for the first, loud after that.
FAIL_STREAK=0

report_failure() {
	FAIL_STREAK=$((FAIL_STREAK + 1))
	log_line "pull failed (${FAIL_STREAK}): ${1:-unknown}"
	if [ "$FAIL_STREAK" -eq 3 ]; then
		# Three in a row is not a restart. Tell the user, because otherwise a
		# dead receiver is indistinguishable from "no files are arriving".
		cmd notification post -t "Taildrop not receiving" -s "$NOTIFY_CHANNEL" \
			"tag" "taildrop-error" "Taildrop not receiving" \
			"Could not reach the daemon: ${1:-unknown}. Received files will not be picked up." \
			>/dev/null 2>&1
	fi
}

report_ok() {
	[ "$FAIL_STREAK" -gt 0 ] && log_line "recovered after ${FAIL_STREAK} failure(s)"
	FAIL_STREAK=0
}

# ---------------------------------------------------------------- singleton --
stop() {
	[ -f "$PIDFILE" ] || return 0
	_pid="$(cat "$PIDFILE" 2>/dev/null)"
	rm -f "$PIDFILE" || true
	[ -n "$_pid" ] || return 0

	# Only ever kill the receiver.
	#
	# The pid file outlives the process: if the receiver is killed, the file
	# stays, and the kernel is free to hand that process number to something
	# else entirely. A later `stop` would then kill that unrelated process --
	# which on a phone is how you take out an app the user never asked you
	# to touch. So the process is checked before it is signalled.
	if [ ! -r "/proc/${_pid}/cmdline" ]; then
		return 0
	fi
	case "$(tr '\0' ' ' < "/proc/${_pid}/cmdline" 2>/dev/null)" in
	*tailscaled.receive*) kill "$_pid" 2>/dev/null || true ;;
	*) : # not ours; leave it alone ;;
	esac
	return 0
}

case "${1:-run}" in
stop)
	stop
	exit 0
	;;
status)
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "receiving: yes (pid $(cat "$PIDFILE"))"
	else
		echo "receiving: no"
	fi
	exit 0
	;;
esac

stop
mkdir -p "$TS_RUN_DIR"

# Only one receiver may run.
#
# Two of them race for the same deliveries: one moves a file out of the
# inbox and the other finds it gone, and both announce it. The pid file only
# remembers one of them, so a receiver left over from an earlier start is not
# stopped by it and the two go on fighting over the same files.
#
# The match is on the full path so that nothing else on the device is
# touched.
for _p in $(pgrep -f '/tailscale/scripts/tailscaled.receive' 2>/dev/null); do
	[ "$_p" = "$$" ] && continue
	kill -9 "$_p" 2>/dev/null
done
sleep 1

echo $$ > "$PIDFILE"

# Take the pid file with us. A stale one is how a later stop ends up
# signalling a process number the kernel has since handed to somebody else.
cleanup_pidfile() {
	[ -f "$PIDFILE" ] || return 0
	[ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ] || return 0
	rm -f "$PIDFILE" 2>/dev/null || true
}
trap cleanup_pidfile EXIT INT TERM

log_line "receiver started (pid $$, destination ${DEST})"

# Drain whatever piled up while we were not running, before blocking.
drain

while :; do
	# drain() does the pulling. It must be the only thing that does: an earlier
	# version also ran `file get --wait` here, which pulled the file into the
	# inbox before drain took its snapshot, so drain then classified the brand
	# new file as already-seen and skipped it. The file arrived and was never
	# announced.
	#
	# The sleep paces the loop. `file get --wait` was tried as the trigger and
	# is not one here: measured on this device it blocks, but it does not wake
	# when a delivery arrives -- a file sent 5s in was still not returned after
	# 40s, while this poll had already picked it up. So polling is the trigger,
	# at 2s. An empty poll costs about 10ms.
	drain
	sleep "${TS_RECEIVE_INTERVAL:-2}"
done