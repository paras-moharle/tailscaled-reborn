#!/system/bin/sh
# tailscaled.api — JSON backend for the companion app.
#
# The companion app has no filesystem or network access of its own; everything it shows
# or changes goes through this script. Keeping the command construction here
# rather than in JavaScript means:
#   - every privileged call is auditable in one place
#   - inputs are validated before they reach a root shell
#   - it can be tested with plain `adb shell su -c` without the WebView
#
# Usage: tailscaled.api <command> [args]
# Output: a single JSON object on stdout. Never exits non-zero for an expected
# error — errors are reported as {"ok":false,"error":"..."}.
set -e
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh

TS_DIR="${TS_DIR:-/data/adb/tailscale}"
TS_BIN_DIR="${TS_BIN_DIR:-${TS_DIR}/bin}"
TS_RUN_DIR="${TS_RUN_DIR:-${TS_DIR}/run}"
TS_LOG_FILE="${TS_LOG_FILE:-${TS_RUN_DIR}/tailscaled.log}"
TS_SCRIPTS_DIR="${TS_SCRIPTS_DIR:-${TS_DIR}/scripts}"

JQ="${TS_BIN_DIR}/jq"
TS_CLI="${TS_BIN_DIR}/tailscale"

# --- helpers ----------------------------------------------------------------

err() {
	printf '{"ok":false,"error":%s}\n' "$("$JQ" -Rn --arg e "$1" '$e')"
	exit 0
}

need_cli() {
	[ -x "$TS_CLI" ] || err "tailscale CLI not found at $TS_CLI"
	ensure_cli_symlink
}

# Validators RETURN a status; they must not call err() themselves. These are
# used from command substitution, where an `exit` would only leave the
# subshell — validation would then silently fail open and the unchecked value
# would reach the tailscale command.

# Allow values we are willing to hand to a root shell: [A-Za-z0-9._:@/+-]
valid_token() {
	printf '%s' "$1" | grep -qE '^[A-Za-z0-9._:@/+-]+$'
}

valid_hostname() {
	printf '%s' "$1" | grep -qE '^[A-Za-z0-9][A-Za-z0-9-]{0,62}$'
}

valid_bool() {
	case "$1" in
	true | false) return 0 ;;
	esac
	return 1
}

ts_json() { timeout 15 "$TS_CLI" "$@" 2>/dev/null; }

current_version() { "$TS_BIN_DIR/tailscaled" --version 2>/dev/null | head -1 | tr -d ' \r'; }

# version_is_newer <a> <b> — dotted numeric compare, ignoring any -pre/-dev suffix
version_is_newer() {
	[ -n "$1" ] && [ -n "$2" ] || return 1
	[ "$1" != "$2" ] || return 1
	_i=1
	while [ "$_i" -le 3 ]; do
		_a=$(echo "$1" | cut -d. -f"$_i" | tr -dc '0-9')
		_b=$(echo "$2" | cut -d. -f"$_i" | tr -dc '0-9')
		_a=${_a:-0}
		_b=${_b:-0}
		[ "$_a" -gt "$_b" ] 2>/dev/null && return 0
		[ "$_b" -gt "$_a" ] 2>/dev/null && return 1
		_i=$((_i + 1))
	done
	return 1
}

module_version() {
	grep '^version=' "${TS_MOD_DIR}/module.prop" 2>/dev/null | cut -d= -f2 || echo unknown
}

# --- status -----------------------------------------------------------------

# The supervisor keeps the daemon and the Taildrop receiver alive. If it is
# gone, so is the thing that would notice a dead daemon, and the phone is one
# crash away from having no Tailscale with nothing to say about it.
#
# Putting it back here means the module repairs itself whenever anything
# looks at it -- the app polls this every few seconds, and so does any script
# that asks the daemon how it is.
supervisor_running() {
	busybox pgrep -f 'keepalive.sh' >/dev/null 2>&1
}

ensure_supervisor() {
	supervisor_running && return 0
	# Only while the daemon is meant to be up. A daemon the user switched off
	# does not need a supervisor, and starting one would be rude.
	[ "$(cat "${TS_RUN_DIR}/daemon.wanted" 2>/dev/null || echo running)" = "running" ] || return 0
	[ -f "${TS_MOD_DIR}/disable" ] && return 0
	[ -f "${TS_SCRIPTS_DIR}/keepalive.sh" ] || return 0
	nohup "${TS_SCRIPTS_DIR}/keepalive.sh" >>"/dev/null" 2>&1 &
	sleep 1
	supervisor_running
}

api_status() {
	need_cli
	_ver="$("$TS_BIN_DIR/tailscaled" --version 2>/dev/null | head -1 | tr -d ' \r')"
	[ -n "$_ver" ] || _ver=unknown

	_daemon=stopped
	# The process name, not the whole command line.
	#
	# `pgrep -f 'tailscaled -no-logs'` matches any process whose command
	# line happens to contain that text -- a shell running a command that
	# mentions the daemon, for instance. That is not a rare thing to
	# happen, and when it does the API reports a daemon that is not
	# running as running, and the supervisor believes the same and never
	# restarts it. `pgrep -x` matches the name exactly, and the daemon's
	# name is exactly "tailscaled".
	busybox pgrep -x tailscaled >/dev/null 2>&1 && _daemon=running

	ensure_supervisor
	_supervisor=stopped
	supervisor_running && _supervisor=running

	# A stopped daemon is a normal state, not an error: the app shows a toggle
	# for it, so report "Stopped" instead of failing the whole request.
	if [ "$_daemon" = running ]; then
		if ! _st="$(ts_json status --json)"; then
			_st='{}'
		fi
	else
		_st='{}'
	fi
	[ -n "$_st" ] || _st='{}'

	if ! _pfx="$(timeout 10 "$TS_CLI" debug prefs 2>/dev/null)"; then
		_pfx='{}'
	fi
	[ -n "$_pfx" ] || _pfx='{}'

	# Ask the release feed, not the GitHub API — see TS_LATEST_URL in
	# settings.sh for why. Falls back to the binary's own check only if the
	# feed is unreachable, since that path is rate limited.
	# Deliberately NO network call here. This endpoint is on the UI's hot path
	# and `tailscale update --dry-run` reaches out to GitHub, which turns a
	# ~200ms local read into a multi-second (or hanging) one. Use
	# `tailscaled.api update-check` for that, off the critical path.
	_latest=""
	_feed_state="unchecked"

	"$JQ" -n \
		--argjson st "$_st" \
		--argjson pf "$_pfx" \
		--arg ver "$_ver" \
		--arg mod "$(module_version)" \
		--arg daemon "$_daemon" \
		--arg supervisor "$_supervisor" \
		--arg latest "$_latest" \
		--arg feed "$_feed_state" \
		--arg adbport "$(getprop persist.adb.tcp.port 2>/dev/null)" \
		'
	  def arr(x): x // [];
	  ($st) as $s | ($pf) as $p |
	  {
	    ok: true,
	    daemon: $daemon,
	    supervisor: $supervisor,
	    backend: (if $daemon == "running" then ($s.BackendState // "NoState") else "Stopped" end),
	    version: $ver,
	    module: $mod,
	    latest: $latest,
	    feed: $feed,
	    # Whether adbd is listening for TCP connections, and on what port.
	    #
	    # It is here so that the app can read it without asking for root a
	    # second time on every refresh. A root call is a process, a pipe and
	    # the root manager, and the app was making two of them every fifteen
	    # seconds for one number.
	    adbPort: $adbport,
	    tailnet: {
	      name: ($s.CurrentTailnet.Name // ""),
	      magicDNS: ($s.CurrentTailnet.MagicDNSEnabled // false),
	      magicDNSSuffix: ($s.MagicDNSSuffix // ""),
	      domain: ($s.CurrentTailnet.Domain // "")
	    },
	    self: {
	      # HostName is the local pref and lags behind a rename made in the admin
	      # console; DNSName reflects the control plane immediately, so prefer its
	      # first label.
	      host: (if ((($s.Self.DNSName // "") | sub("\\.$"; "") | split(".")[0]) | length) > 0
	              then (($s.Self.DNSName // "") | sub("\\.$"; "") | split(".")[0])
	              else ($s.Self.HostName // "")
	              end),
	      os: ($s.Self.OS // ""),
	      online: ($s.Self.Online // false),
	      # PeerRelay, not Relay. Relay is the home DERP relay for the
	      # node and is set even on a perfectly direct connection, so
	      # reporting it said "blr" while the CLI said "direct".
	      # PeerRelay is the relay actually in use, empty when direct.
	      relay: ($s.Self.PeerRelay // ""),
	      direct: ((($s.Self.PeerRelay // "") == "") and ($s.Self.Online // false)),
	      curAddr: ($s.Self.CurAddr // ""),
	      tailscaleIPs: arr($s.Self.TailscaleIPs),
	      addrs: arr($s.Self.Addrs),
	      exitNodeOption: ($s.Self.ExitNodeOption // false),
	      tags: arr($s.Self.Tags)
	    },
	    exitNode: (
	      if ($s.ExitNodeStatus.ID // "") != "" then {
	        id: $s.ExitNodeStatus.ID,
	        ip: ($s.ExitNodeStatus.TailscaleIPs[0] // ""),
	        online: ($s.ExitNodeStatus.Online // false)
	      } else null end
	    ),
	    prefs: {
	      wantRunning: ($p.WantRunning // false),
	      shieldsUp: ($p.ShieldsUp // false),
	      acceptDNS: ($p.CorpDNS // false),
	      routeAll: ($p.RouteAll // false),
	      advertiseExitNode: (arr($p.AdvertiseRoutes) | index("0.0.0.0/0") != null),
	      advertiseRoutes: arr($p.AdvertiseRoutes),
	      exitNodeID: ($p.ExitNodeID // ""),
	      runSSH: ($p.RunSSH // false),
	      runWebClient: ($p.RunWebClient // false),
	      netfilterMode: ($p.NetfilterMode // ""),
	      snatSubnetRoutes: ($p.NoSNAT | not),
	      hostname: ($p.Hostname // ""),
	      loggedOut: ($p.LoggedOut // false)
	    },
	    peers: [
	      ($s.Peer // {} | to_entries[]) |
	      .value |
	      {
	        id: .ID,
	        host: (.HostName // ""),
	        os: (.OS // ""),
	        online: (.Online // false),
	        relay: (.PeerRelay // ""),
	        ips: arr(.TailscaleIPs),
	        rx: (.RxBytes // 0),
	        tx: (.TxBytes // 0),
	        lastSeen: (.LastSeen // ""),
        direct: ((.PeerRelay // "") == "" and (.Online // false)),
        curAddr: (.CurAddr // ""),
        active: (.Active // false),
	        exitNode: (.ExitNodeOption // false),
	        active: (.Active // false),
	        tags: arr(.Tags)
	      }
	    ]
	  }
	'
}

# --- prefs / toggles --------------------------------------------------------

api_prefs() { api_status; }

# set <key> <value>
api_set() {
	need_cli
	_k="${1:-}"
	_v="${2:-}"
	[ -n "$_k" ] || err "set: missing key"

	case "$_k" in
	accept-dns | shields-up | accept-routes | advertise-exit-node | run-ssh | run-webclient | snat-subnet-routes)
		valid_bool "$_v" || err "set: $_k expects true or false, got '$_v'"
		case "$_k" in
		accept-dns) _flag="--accept-dns=$_v" ;;
		shields-up) _flag="--shields-up=$_v" ;;
		accept-routes) _flag="--accept-routes=$_v" ;;
		advertise-exit-node) _flag="--advertise-exit-node=$_v" ;;
		run-ssh) _flag="--ssh=$_v" ;;
		run-webclient) _flag="--webclient=$_v" ;;
		snat-subnet-routes) _flag="--snat-subnet-routes=$_v" ;;
		esac
		;;
	netfilter-mode)
		valid_token "$_v" || err "set: invalid netfilter-mode '$_v'"
		_flag="--netfilter-mode=$_v"
		;;
	hostname)
		valid_hostname "$_v" || err "set: invalid hostname '$_v'"
		_flag="--hostname=$_v"
		;;
	exit-node)
		if [ "$_v" = "none" ]; then
			_flag="--exit-node=none"
		else
			valid_token "$_v" || err "set: invalid exit node '$_v'"
			_flag="--exit-node=$_v"
		fi
		;;
	advertise-routes)
		# comma-separated CIDRs, e.g. "192.168.1.0/24" or "" to clear
		if [ -n "$_v" ]; then
			printf '%s' "$_v" | grep -qE '^[0-9a-fA-F.:/]+(,[0-9a-fA-F.:/]+)*$' \
				|| err "set: invalid routes '$_v'"
		fi
		_flag="--advertise-routes=$_v"
		;;
	*)
		err "set: unknown key '$_k'"
		;;
	esac

	# _flag is built only from validated pieces; still guard the empty case.
	[ -n "$_flag" ] || err "set: nothing to do for '$_k'"

	_out="$(timeout 20 "$TS_CLI" set "$_flag" 2>&1)" || {
		printf '{"ok":false,"error":%s}\n' "$("$JQ" -Rn --arg e "${_out:-set failed}" '$e')"
		return 0
	}
	# `tailscale set` is silent on success
	api_status
}

# --- login ------------------------------------------------------------------

# update-check — network-backed, slow. Kept separate from `status` so the
# dashboard never waits on GitHub.
api_update_check() {
	need_cli
	_cur="$(current_version 2>/dev/null || true)"
	if _lv="$(latest_version 2>/dev/null)" && [ -n "$_lv" ]; then
		# A real JSON boolean, not the string "false". This used to quote it,
		# so the field's type depended on which reader looked at it: Java's
		# optBoolean happens to parse the string, but a shell or jq consumer
		# testing `.available == false` would compare a string to a boolean
		# and quietly get the wrong answer.
		_avail=false
		version_is_newer "${_cur:-0}" "$_lv" && _avail=true
		printf '{"ok":true,"current":%s,"latest":%s,"available":%s,"source":"feed"}\n' \
			"$("$JQ" -Rn --arg c "$_cur" '$c')" \
			"$("$JQ" -Rn --arg l "$_lv" '$l')" \
			"$_avail"
		return 0
	fi
	_out="$(timeout 60 "$TS_CLI" update --dry-run 2>&1)" || true
	case "$_out" in
	*"no update needed"* | *"already running"*)
		printf '{"ok":true,"current":%s,"latest":%s,"available":false,"source":"binary"}\n' \
			"$("$JQ" -Rn --arg c "$_cur" '$c')" "$("$JQ" -Rn --arg c "$_cur" '$c')"
		;;
	*403* | *"rate limit"*)
		printf '{"ok":false,"error":"rate limited by GitHub; try again later"}\n'
		;;
	*)
		# Parse "Update available: 1.105.0" or "a newer version (1.105.0) is available"
		# or "to 1.105.0" from the dry-run output. Try multiple patterns.
		_lv2="$(printf '%s\n' "$_out" | \
			sed -n \
				-e 's/.*[Uu]pdate [aA]vailable: \([0-9.]*\).*/\1/p' \
				-e 's/.*to \([0-9][0-9.]*\).*/\1/p' \
				-e 's/.*newer version (\([0-9.]*\)).*/\1/p' \
				-e 's/.*version \([0-9][0-9.]*\) is.*/\1/p' \
			| head -1)"
		[ -n "$_lv2" ] || _lv2="$_cur"
		# `available` must mean what the feed path means by it: latest is
		# genuinely newer than what is running. This branch used to hardcode
		# true, so a dry-run that reported the version already installed came
		# back as "an update is available" with latest == current. Callers that
		# trusted the flag alone offered an install of the same binary.
		_avail2=false
		[ "$_lv2" != "$_cur" ] && version_is_newer "${_cur:-0}" "$_lv2" && _avail2=true
		printf '{"ok":true,"current":%s,"latest":%s,"available":%s,"source":"binary"}\n' \
			"$("$JQ" -Rn --arg c "$_cur" '$c')" "$("$JQ" -Rn --arg l "$_lv2" '$l')" \
			"$_avail2"
		;;
	esac
}

api_login() {
	need_cli
	_state="$(ts_json status --json | "$JQ" -r '.BackendState // "NoState"')"
	case "$_state" in
	Running | NeedsMachineAuth | Starting)
		printf '{"ok":true,"alreadyLoggedIn":true,"url":"","backend":%s}\n' \
			"$("$JQ" -Rn --arg b "$_state" '$b')"
		return 0
		;;
	esac

	_tmp="${TS_RUN_DIR}/login.out"
	_pidf="${TS_RUN_DIR}/login.pid"
	: >"$_tmp"
	chmod 0666 "$_tmp" 2>/dev/null || true

	# `tailscale login` blocks until the browser round-trip completes, which can
	# be minutes, and unlike `tailscale up` it does not touch preferences -- `up`
	# refuses to run at all when any non-default flag is set, which is exactly
	# the state a user who has ever changed a setting is in.
	# minutes. It must NOT be a child of this script: the caller is a transient
	# `su` session from the app, torn down as soon as it has read our output, and
	# a login killed at that point never completes -- the app reports success and
	# the device simply stays signed out.
	#
	# nohup inside a detached subshell, so it is reparented to init and outlives
	# us. The pid is recorded so a retry can tell a pending login from a new one.
	if [ -f "$_pidf" ] && kill -0 "$(cat "$_pidf" 2>/dev/null)" 2>/dev/null; then
		: # a login is already waiting for the browser
	else
		( nohup timeout 600 "$TS_CLI" login >"$_tmp" 2>&1 & echo $! >"$_pidf" )
	fi

	_url=""
	_i=0
	while [ "$_i" -lt 20 ]; do
		sleep 1
		_url="$(grep -oE 'https://login\.tailscale\.com/[a-zA-Z0-9/._?=&-]+' "$_tmp" 2>/dev/null | head -1)"
		[ -n "$_url" ] && break
		_i=$((_i + 1))
	done

	_raw="$("$JQ" -Rs '.[-400:]' <"$_tmp" 2>/dev/null || printf '""')"
	if [ -z "$_url" ]; then
		# Silent failure is the worst outcome here: the app would report that
		# sign-in started and then nothing would ever happen.
		printf '{"ok":false,"error":"no auth URL from tailscale login","raw":%s}\n' "$_raw"
		rm -f "$_pidf"
		return 0
	fi

	printf '{"ok":true,"alreadyLoggedIn":false,"url":%s,"raw":%s}\n' \
		"$("$JQ" -Rn --arg u "$_url" '$u')" "$_raw"
	rm -f "$_pidf"
}

api_logout() {
	need_cli
	timeout 20 "$TS_CLI" logout >/dev/null 2>&1 || err "logout failed"
	api_status
}

# --- files (Taildrop) --------------------------------------------------------

DEFAULT_ROOTS='["/sdcard/Download","/sdcard/Documents","/data/adb/tailscale/inbox"]'

api_files() {
	need_cli
	_dir="${1:-/sdcard/Download}"
	# allow only real, existing directories under user-writable storage
	case "$_dir" in
	/sdcard/* | /storage/emulated/0/* | /data/adb/tailscale/*) ;;
	*) err "files: directory not allowed: $_dir" ;;
	esac
	[ -d "$_dir" ] || err "files: no such directory: $_dir"

	_entries="$(ls -la "$_dir" 2>/dev/null || true)"
	printf '%s' "$_entries" | "$JQ" -R -s --arg dir "$_dir" --argjson roots "$DEFAULT_ROOTS" '
	  split("\n") | map(select(length > 0)) |
	  map(
	    (.|split(" ")) as $f |
	    select(($f|length) > 6) |
	    {
	      name: ($f[-1] | sub(" ->.*$";"")),
	      size: (($f[4] // "0") | tonumber? // 0),
	      dir: (($f[0] | startswith("d")) or ($f[0] | startswith("l")))
	    }
	  ) |
	  { ok: true, dir: $dir, roots: $roots, entries: . }
	'
}

# send <peer-ip-or-host> <abs-path>
api_send() {
	need_cli
	_peer="${1:-}"
	_path="${2:-}"
	[ -n "$_peer" ] && [ -n "$_path" ] || err "send: usage: send <peer> <path>"
	valid_token "$_peer" || err "invalid peer: $_peer"
	case "$_path" in
	/sdcard/* | /storage/emulated/0/* | /data/*) ;;
	*) err "send: path not allowed: $_path" ;;
	esac
	[ -f "$_path" ] || err "send: no such file: $_path"

	_dest="$(printf '%s:' "$_peer" | sed 's/^\([^:]*\):$/\1:/')"

	# `tailscale file cp` exits 0 even when the transfer never happens. A peer
	# that cannot receive files -- because the tailnet does not grant the
	# file-sharing capability -- produces "502 Bad Gateway" and a zero status,
	# and the UI reported every one of those as a successful send.
	#
	# So the exit code is not taken as proof. Success requires positive
	# confirmation that the CLI claimed the file was sent.
	set +e
	# Sized to the file. A flat timeout truncates large sends: killing the CLI
	# mid-transfer leaves the daemon's partial file behind, the CLI exits
	# cleanly, and the sender is told it worked. 300s was enough for a photo and
	# nowhere near enough for a folder.
	_size="$(wc -c < "$_path" 2>/dev/null || echo 0)"
	case "$_size" in '' | *[!0-9]*) _size=0 ;; esac
	# Same reasoning as the desktop sender: a floor of 300s, scaled by size at
	# a pessimistic 100 KB/s, and capped so a huge file cannot hold the API open
	# indefinitely. Directly connected, a gigabyte goes in seconds.
	_timeout=300
	if [ "$_size" -gt 40000000 ]; then
		_timeout=$(( _size / 100000 + 300 ))
		[ "$_timeout" -gt 14400 ] && _timeout=14400
	fi
	_out="$(timeout "$_timeout" "$TS_CLI" file cp "$_path" "$_dest" 2>&1)"
	_rc=$?
	set -e

	# Absence of output is NOT failure. On this Android build `tailscale file
	# cp` prints nothing at all on success -- it hands the file to the daemon
	# and exits 0 -- so requiring a "sent" line reported every working send as
	# a failure. Only an actual error is treated as failure:
	#
	#   - a non-zero exit
	#   - the CLI saying so in words ("502 Bad Gateway", "unknown target")
	#
	# The daemon delivers straight into Downloads and keeps no inbox, so there
	# is no local receipt that proves arrival. This can confirm failure, never
	# success, and says so rather than pretending.
	_failed=no
	if [ "$_rc" -ne 0 ]; then
		_failed=yes
	else
		# stderr is read, but a warning is not an error. A peer that has been
		# idle makes the CLI print
		#     # warning: 100.76.39.7 is not replying; trying anyway
		# and then deliver the file anyway over a relay. The Nautilus
		# extension was rewritten for exactly this and reported delivered
		# files as failures while the phone was asleep.
		#
		# So: anything that is not a diagnostic line and not a warning counts
		# as failure, rather than a fixed list of words being required to
		# catch one. An unfamiliar failure cannot slip through as success.
		if printf '%s\n' "$_out" | tr -d '\r' |
			grep -viE '#|warning' |
			grep -qE '[[:alnum:]]'; then
			_failed=yes
		fi
	fi

	if [ "$_failed" = "yes" ]; then
		# Surface whatever the CLI actually said. "502 Bad Gateway" on its own
		# is a dead end; paired with "unknown target" it points straight at the
		# peer, and a grants-policy failure is worth naming.
		_detail="$(printf '%s' "$_out" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
		case "$_detail" in
		*"Bad Gateway"*|*"unknown target"*|*"not in your Tailnet"*)
			_detail="$_detail (the tailnet may not grant file-sharing to this device)" ;;
		esac
		[ -n "$_detail" ] || _detail="tailscale file cp exited $_rc without sending"
		printf '{"ok":false,"error":%s}\n' \
			"$("$JQ" -Rn --arg e "$_detail" '$e')"
		return 0
	fi

	printf '{"ok":true,"sent":%s,"to":%s}\n' \
		"$("$JQ" -Rn --arg p "$_path" '$p')" \
		"$("$JQ" -Rn --arg d "$_dest" '$d')"
}

# receive [wait_seconds] — move whatever is waiting in the Taildrop inbox.
#
# `tailscale file get` takes a target DIRECTORY and pulls from every peer at
# once; it has no per-peer argument. Use --wait to block for new arrivals.
api_receive() {
	need_cli
	_wait="${1:-0}"
	printf '%s' "$_wait" | grep -qE '^[0-9]{1,4}$' || _wait=0

	_inbox="${TS_DIR}/inbox"
	mkdir -p "$_inbox"
	chmod 0700 "$_inbox"

	if [ "$_wait" -gt 0 ]; then
		_out="$(timeout $((_wait + 10)) "$TS_CLI" file get --wait "$_inbox" 2>&1)"
	else
		_out="$(timeout 60 "$TS_CLI" file get "$_inbox" 2>&1)"
	fi
	_rc=$?

	printf '{"ok":%s,"dir":%s,"output":%s}\n' \
		"$([ "$_rc" -eq 0 ] && echo true || echo false)" \
		"$("$JQ" -Rn --arg d "$_inbox" '$d')" \
		"$("$JQ" -Rs '.' <<-EOF
			$_out
		EOF
		)"
}

# --- diagnostics -------------------------------------------------------------

api_logs() {
	_n="${1:-120}"
	printf '%s' "$_n" | grep -qE '^[0-9]{1,5}$' || _n=120
	_tail="$(busybox tail -n "$_n" "${TS_LOG_FILE}" 2>/dev/null || echo '')"
	printf '{"ok":true,"log":%s}\n' "$("$JQ" -Rs '.' <<-EOF
		$_tail
	EOF
	)"
}

api_service() {
	_act="${1:-status}"
	case "$_act" in
	start | stop | restart) ;;
	status) ;;
	*) err "service: unknown action $_act" ;;
	esac
	timeout 90 "${TS_SCRIPTS_DIR}/tailscaled.service" "$_act" >/dev/null 2>&1 || true
	sleep 2
	api_status
}

api_update() {
	#
	# Report what actually happened.
	#
	# This used to discard the updater's output and `|| true` its exit status,
	# then return a plain status. The app therefore said "Done" after a failed
	# download exactly as it did after a successful install, which is the one
	# thing a user cannot forgive: they were told their daemon was updated while
	# it had not been.
	#
	# The updater records the outcome in run/update.state (`ok-<version>`,
	# `failed-update`, `rolled-back`), so read that and compare the binary's
	# version either side of the run. Both are needed: state says whether it
	# worked, the version pair says whether anything actually changed.
	#
	_before="$(current_version)"
	timeout 900 "${TS_SCRIPTS_DIR}/tailscaled.update" run >/dev/null 2>&1 || true
	_after="$(current_version)"
	_state="$(cat "${TS_RUN_DIR}/update.state" 2>/dev/null || echo unknown)"

	_b="$("$JQ" -Rn --arg v "${_before:-unknown}" '$v')"
	_a="$("$JQ" -Rn --arg v "${_after:-unknown}" '$v')"
	_s="$("$JQ" -Rn --arg v "${_state:-unknown}" '$v')"

	case "$_state" in
		failed-update | rolled-back)
			_reason="$(grep -m1 -i 'Error' "${TS_RUN_DIR}/runs.log" 2>/dev/null |
				tail -1 | sed 's/^.*\[Error\]: *//')"
			[ -n "$_reason" ] || _reason="the updater reported ${_state}"
			printf '{"ok":false,"error":%s,"before":%s,"after":%s,"state":%s}\n' \
				"$("$JQ" -Rn --arg e "$_reason" '$e')" "$_b" "$_a" "$_s"
			;;
		ok-*)
			if [ "$_before" = "$_after" ]; then
				printf '{"ok":true,"updated":false,"before":%s,"after":%s,"state":%s}\n' \
					"$_b" "$_a" "$_s"
			else
				printf '{"ok":true,"updated":true,"before":%s,"after":%s,"state":%s}\n' \
					"$_b" "$_a" "$_s"
			fi
			;;
		*)
			# No usable state: do not claim a result that was never recorded.
			printf '{"ok":false,"error":"the updater did not report an outcome","before":%s,"after":%s,"state":%s}\n' \
				"$_b" "$_a" "$_s"
			;;
	esac
}

# ---------------------------------------------------------------- clipboard --
#
# The clipboard is read, written and watched by a small helper that runs under
# app_process as the shell uid. See tailscale/scripts/clipwatch.sh for why the
# uid matters: as root it would wipe the user's clipboard.
CLIP_DEX="${TS_CLIP_DEX_RUN:-/data/local/tmp/tailbridge-clip.dex}"
CLIP_CLASS="${TS_CLIP_CLASS:-com.paras.tailbridge.clip.ClipBoard}"
CLIP_STORE="${TS_CLIP_STORE:-${TS_DIR}/clipboard.jsonl}"

# clip_run <mode> [stdin-file]
#
# Runs the helper as uid 2000 and prints what it says. Everything the helper
# prints is one item per line; the text is base64 so nothing is lost in
# transit.
clip_run() {
	_mode="$1"
	_in="${2:-/dev/null}"
	# The helper has to be somewhere the shell uid can read, and it has to be
	# read-only there or ART refuses to load it. Put it back if it went
	# missing.
	ensure_clip_dex >/dev/null 2>&1
	[ -f "$CLIP_DEX" ] || { echo "err:no clipboard helper"; return 1; }
	su 2000 -c "CLASSPATH='${CLIP_DEX}' app_process /system/bin ${CLIP_CLASS} ${_mode} com.android.shell" \
		< "$_in" 2>/dev/null
}

# The store, with the text readable.
#
# On disk the text is encrypted: the key is in the device's hardware
# keystore, so a copy of the storage is a copy of ciphertext. The helper
# decrypts the whole file in one pass -- one process for the file, rather
# than one per entry, which at five thousand entries would take minutes.
#
# If the keystore cannot be reached the store is handed over as it is, so
# the feature keeps working; the watcher says so in the log when that
# happens.
clip_store_plain() {
	# The whole store, with the text readable.
	#
	# Only the entries that are asked for are opened. The hardware takes a
	# few milliseconds for each one, and a history of five thousand entries
	# would take a minute and a half to open all of it, which is a long
	# time to hold up a screen.
	[ -f "$CLIP_STORE" ] || { return 0; }
	_dec="$(clip_crypto decrypt-store < "$CLIP_STORE" 2>/dev/null)"
	if [ -n "$_dec" ]; then
		printf '%s' "$_dec"
	else
		cat "$CLIP_STORE" 2>/dev/null
	fi
}

# clip_store_tail <how many>
#
# The newest entries, with the text readable.
clip_store_tail() {
	_n="${1:-200}"
	[ -f "$CLIP_STORE" ] || { return 0; }
	_last="$(tail -n "$_n" "$CLIP_STORE" 2>/dev/null)"
	[ -n "$_last" ] || { return 0; }
	_dec="$(printf '%s' "$_last" | clip_crypto decrypt-store 2>/dev/null)"
	if [ -n "$_dec" ]; then
		printf '%s' "$_dec"
	else
		printf '%s' "$_last"
	fi
}

# Bring the store within its limits now.
clip_prune() {
	_max="$(clip_conf max 5000)"
	case "$_max" in '' | *[!0-9]*) _max=5000 ;; esac
	[ -f "$CLIP_STORE" ] || return 0
	_lines="$(wc -l < "$CLIP_STORE" 2>/dev/null || echo 0)"
	case "$_lines" in '' | *[!0-9]*) _lines=0 ;; esac
	[ "$_lines" -gt "$_max" ] || return 0
	# Starred entries are kept whatever the limit is.
	_tmp="${CLIP_STORE}.tmp.$$"
	if "$JQ" -c -s --argjson n "$_max" '
			. as $all
			| ($all | map(select((.p // 0) != 1)) | reverse | .[0:$n]) as $keep
			| (if ($keep | length) == 0 then {} else ($keep | map({(.t | tostring): true}) | add) end) as $keepMap
			| $all | map(select((.p // 0) == 1 or ($keepMap[(.t | tostring)] == true))) | .[]
		' "$CLIP_STORE" > "$_tmp" 2>/dev/null; then
		mv -f "$_tmp" "$CLIP_STORE" 2>/dev/null || rm -f "$_tmp" 2>/dev/null
		# A file written by the shell gets whatever the umask says, and
		# the store is meant to be readable by root alone.
		chmod 0600 "$CLIP_STORE" 2>/dev/null
		chmod 0600 "$CLIP_STORE" 2>/dev/null
	else
		rm -f "$_tmp" 2>/dev/null
	fi
	return 0
}

# clip_mark <timestamp> <1 or 0>
#
# Star an entry, or unstar it. The timestamp is what identifies it: the
# store is a list of lines with no other handle, and a copy of a thing
# happens once.
clip_mark() {
	_t="${1:-}"
	_p="${2:-1}"
	[ -n "$_t" ] || err "clipboard: star needs a timestamp"
	[ -f "$CLIP_STORE" ] || { printf '{"ok":true}\n'; return 0; }
	_tmp="${CLIP_STORE}.tmp.$$"
	if "$JQ" -c --argjson t "$_t" --argjson p "$_p" \
		'if ((.t // 0) == $t) then .p = $p else . end' \
		"$CLIP_STORE" > "$_tmp" 2>/dev/null; then
		mv -f "$_tmp" "$CLIP_STORE" 2>/dev/null || rm -f "$_tmp" 2>/dev/null
		# A file written by the shell gets whatever the umask says, and
		# the store is meant to be readable by root alone.
		chmod 0600 "$CLIP_STORE" 2>/dev/null
	else
		rm -f "$_tmp" 2>/dev/null
	fi
	printf '{"ok":true}\n'
}

# clip_delete <timestamp>
clip_delete() {
	_t="${1:-}"
	[ -n "$_t" ] || err "clipboard: delete needs a timestamp"
	[ -f "$CLIP_STORE" ] || { printf '{"ok":true}\n'; return 0; }
	_tmp="${CLIP_STORE}.tmp.$$"
	if "$JQ" -c --argjson t "$_t" 'select((.t // 0) != $t)' \
		"$CLIP_STORE" > "$_tmp" 2>/dev/null; then
		mv -f "$_tmp" "$CLIP_STORE" 2>/dev/null || rm -f "$_tmp" 2>/dev/null
		# A file written by the shell gets whatever the umask says, and
		# the store is meant to be readable by root alone.
		chmod 0600 "$CLIP_STORE" 2>/dev/null
	else
		rm -f "$_tmp" 2>/dev/null
	fi
	printf '{"ok":true}\n'
}

api_clipboard() {
	_cmd="${1:-list}"
	shift 2>/dev/null || true
	case "$_cmd" in
	list)
		# Newest first, and only as many as were asked for.
		#
		# The whole store was returned before, pretty-printed, over a root
		# round trip, on every refresh. At the 5000 entry limit that is
		# about 400 KB each time, which is a lot of work to do several
		# times a minute for a list nobody is looking at that far down.
		_n="${1:-200}"
		case "$_n" in '' | *[!0-9]*) _n=200 ;; esac
		[ "$_n" -gt 5000 ] && _n=5000
		# -c: one entry per line. Pretty-printed, the same data is three
		# times the size and the app has to parse all of it.
		#
		# Only the entries that are asked for are opened. The hardware
		# takes a few milliseconds for each one.
		clip_store_tail "$_n" | "$JQ" -c -s --argjson n "$_n" 'reverse | .[0:$n] | .[]' \
			2>/dev/null || echo "[]"
		;;
	search)
		_q="${1:-}"
		[ -n "$_q" ] || { err "clipboard: search needs a query"; }
		# The text is base64 in the store, so it has to be decoded before it
		# can be matched. jq does that.
		#
		# The store is decrypted first: the text on disk is ciphertext, and
		# there is nothing to match against until it is readable again.
		clip_store_plain | "$JQ" -s --arg q "$_q" '
			[ .[] | select((.c | @base64d) | contains($q)) ] | reverse
		' 2>/dev/null || echo "[]"
		echo
		;;
	get)
		# The clipboard right now, not the last one recorded.
		_out="$(clip_run get)"
		_text=""
		_uri=""
		_src=""
		while IFS= read -r _l; do
			case "$_l" in
			text:*)
				_rest="${_l#text:}"
				_text="$(printf '%s' "$_rest" | cut -d'|' -f1)"
				_src="$(printf '%s' "$_rest" | cut -d'|' -f2-)"
				[ "$_src" = "$_rest" ] && _src=""
				;;
			uri:*) _uri="${_l#uri:}" ;;
			esac
		done <<EOF
$_out
EOF
		printf '{"ok":true,"text":%s,"uri":%s,"source":%s}\n' \
			"$("$JQ" -Rn --arg t "$_text" '$t')" \
			"$("$JQ" -Rn --arg u "$_uri" '$u')" \
			"$("$JQ" -Rn --arg s "$_src" '$s')"
		;;
	send)
		_peer="${1:-}"
		[ -n "$_peer" ] || err "clipboard: send needs a peer"
		valid_token "$_peer" || err "invalid peer: $_peer"
		clip_send "$_peer"
		;;
	clear)
		: > "$CLIP_STORE" 2>/dev/null || true
		printf '{"ok":true}\n'
		;;
	config)
		# What the watcher is doing, as opposed to what it has done.
		printf '{"ok":true,"watch":%s,"max":%s,"days":%s}\n' \
			"$("$JQ" -Rn --arg v "$(clip_conf watch true)" '$v')" \
			"$("$JQ" -Rn --arg v "$(clip_conf max 5000)" '$v')" \
			"$("$JQ" -Rn --arg v "$(clip_conf days 0)" '$v')"
		;;
	set)
		_key="${1:-}"
		_val="${2:-}"
		[ -n "$_key" ] || err "clipboard: set needs a key"
		case "$_key" in
		watch)
			case "$_val" in
			true | false) ;;
			*) err "clipboard: watch expects true or false, got '$_val'" ;;
			esac
			;;
		max)
			case "$_val" in
			'' | *[!0-9]*) err "clipboard: max expects a number, got '$_val'" ;;
			esac
			[ "$_val" -ge 10 ] || err "clipboard: max must be at least 10"
			[ "$_val" -le 50000 ] || err "clipboard: max must be at most 50000"
			;;
		days)
			# How long to keep an entry. Zero means for ever.
			case "$_val" in
			'' | *[!0-9]*) err "clipboard: days expects a number, got '$_val'" ;;
			esac
			[ "$_val" -le 3650 ] || err "clipboard: days must be at most 3650"
			;;
		*) err "clipboard: unknown setting $_key" ;;
		esac
		clip_conf_set "$_key" "$_val"
		# Keep the store within the new limits straight away, rather than
		# waiting for the next copy to trigger a prune.
		case "$_key" in
		max | days) clip_prune ;;
		esac
		printf '{"ok":true}\n'
		;;
	star)
		clip_mark "$1" 1
		;;
	unstar)
		clip_mark "$1" 0
		;;
	delete)
		clip_delete "$1"
		;;
	apps)
		# Which apps have copied something, and how often.
		#
		# This is the list the settings show, so the user can tell a
		# password manager to keep its copies to itself without having to
		# know the package name.
		"$JQ" -s '
			[ .[] | select((.s // "") != "") ]
			| group_by(.s)
			| map({ source: .[0].s, count: length })
			| sort_by(-.count)
		' "$CLIP_STORE" 2>/dev/null || echo "[]"
		echo
		;;
	*)
		err "clipboard: unknown command $_cmd"
		;;
	esac
}

# Send the current clipboard to a peer.
#
# It travels as an ordinary Taildrop file whose name says what it is, so the
# existing send path is used unchanged and the receiver on the other side
# already knows how to move files around.
clip_send() {
	_peer="$1"
	_out="$(clip_run get)"
	_text=""
	_src=""
	while IFS= read -r _l; do
		case "$_l" in
		text:*)
			_rest="${_l#text:}"
			_text="$(printf '%s' "$_rest" | cut -d'|' -f1)"
			_src="$(printf '%s' "$_rest" | cut -d'|' -f2-)"
			[ "$_src" = "$_rest" ] && _src=""
			;;
		esac
	done <<EOF
$_out
EOF
	[ -n "$_text" ] || { err "clipboard: the clipboard is empty"; }

	mkdir -p "$TS_DIR/tmp" 2>/dev/null
	_mk="$TS_DIR/tmp/clip-$(date +%s 2>/dev/null || echo 0).clip"
	# A small header so the receiver knows the time and the source app
	# without having to guess. The magic line is what distinguishes a
	# clipboard from an ordinary file that happens to end in .clip.
	{
		printf 'TBCLIP1\n'
		printf '{"t":%s,"s":%s}\n' \
			"$(date +%s 2>/dev/null || echo 0)" \
			"$("$JQ" -Rn --arg s "$_src" '$s')"
		printf '%s' "$_text"
	} > "$_mk" 2>/dev/null

	api_send "$_peer" "$_mk"
	_rc=$?
	rm -f "$_mk" 2>/dev/null
	return $_rc
}

api_version() {
	printf '{"ok":true,"module":%s,"binary":%s}\n' \
		"$("$JQ" -Rn --arg m "$(module_version)" '$m')" \
		"$("$JQ" -Rn --arg b "$("$TS_BIN_DIR/tailscaled" --version 2>/dev/null | head -1 | tr -d ' \r')" '$b')"
}

case "${1:-}" in
status) api_status ;;
prefs) api_prefs ;;
set)
	shift
	api_set "$@"
	;;
update-check) api_update_check ;;
login) api_login ;;
logout) api_logout ;;
files) shift; api_files "$@" ;;
send)
	shift
	api_send "$@"
	;;
receive)
	shift
	api_receive "$@"
	;;
received)
	# Return what the receive loop recorded last.
	# tailscaled.receive writes ${TS_RUN_DIR}/last-received every time new
	# arrivals are exported. Return its content so the app can show
	# "N files arrived while you were away".
	#
	# last-received is written by tailscaled.receive as `key=value` lines
	# (at=, count=, names=, dir=), not as JSON. Reading it with `jq .` fails,
	# and because that failure was swallowed the count read as zero forever.
	_LR="${TS_RUN_DIR}/last-received"
	_lr_val() { grep -m1 "^$1=" "$_LR" 2>/dev/null | cut -d= -f2-; }
	_at=$(_lr_val at | tr -dc '0-9')
	_count=$(_lr_val count | tr -dc '0-9')
	_names=$(_lr_val names)
	_dir=$(_lr_val dir)
	case "${_at:-}" in '' | *[!0-9]*) _at=0 ;; esac
	case "${_count:-}" in '' | *[!0-9]*) _count=0 ;; esac
	# jq does the quoting, so names with spaces or quotes survive; an empty
	# list has to stay [] and not null.
	_json_names=$(printf '%s' "${_names:-}" | tr ',' '\n' |
		"$JQ" -R -n '[inputs | select(length > 0)]' 2>/dev/null)
	case "${_json_names:-}" in '' | null) _json_names='[]' ;; esac
	# Flat, because the app reads count off the top level.
	printf '{"ok":true,"count":%s,"at":%s,"dir":%s,"names":%s}\n' \
		"${_count:-0}" "${_at:-0}" \
		"$("$JQ" -Rn --arg d "${_dir:-${TS_TAILDROP_DIR}}" '$d')" \
		"${_json_names:-[]}"
	;;
logs)
	shift
	api_logs "$@"
	;;
service)
	shift
	api_service "$@"
	;;
update) api_update ;;
clipboard)
	shift
	api_clipboard "$@"
	;;
version) api_version ;;
*)
	err "unknown command: ${1:-<none>}"
	;;
esac