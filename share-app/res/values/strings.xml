	<string name="about">About</string>
	<string name="credits_body">Tailscale daemon built from upstream Tailscale with the Android port (kxxt) by paras-moharle.\n\nModule: Magisk-Tailscaled, originally by anasfanani.\nDaemon interface: Tailscale, Inc.\n\nTailscale is a trademark of Tailscale Inc. This app is not affiliated with them.</string>
	<string name="github_link">Project on GitHub</string>

	<!-- root -->
	<string name="need_root_short">Root needed</string>
	<string name="need_root">TailBridge talks to the tailscaled daemon in the Tailscale module, which lives in a root-only directory, so TailBridge needs root permission.</string>
	<string name="grant_root">Grant root permission</string>
	<string name="grant_root_title">Grant root\npermission</string>
	<string name="grant_root_body">TailBridge talks to the tailscaled daemon, which lives in a root-only directory. Your root manager has to be told to trust this app.</string>
	<string name="grant_root_back">Then come back here \u2014 TailBridge checks again on its own.</string>
