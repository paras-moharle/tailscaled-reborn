	<string name="nav_dns">DNS</string>
	<string name="page_dns">Tailnet DNS</string>
	<string name="dns_hero_fallback_title">Network DNS</string>
	<string name="dns_hero_body">Nameservers, search domains and MagicDNS belong to the whole tailnet, so they are set here once and every device follows.</string>
	<string name="dns_magic_on">MagicDNS on</string>
	<string name="dns_magic_off">MagicDNS off</string>
