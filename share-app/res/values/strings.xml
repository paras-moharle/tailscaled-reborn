	<string name="dns_connect_title">Connect your tailnet</string>
	<string name="dns_connect_body">MagicDNS, global nameservers and search domains live in Tailscale\u2019s control plane, not on this phone \u2014 which is why the daemon cannot change them. A tailnet key unlocks them here.</string>
	<string name="dns_step_1">Sign in to the admin console.</string>
	<string name="dns_step_2">Settings  \u2192  Keys  \u2192  Generate access token.</string>
	<string name="dns_step_3">Paste it below. It is encrypted with a key held in this phone\u2019s keystore, so no other app can read it.</string>
	<string name="dns_token_note">A tailnet key carries the same permissions as your account, not just DNS. Give it a short expiry and revoke it in the console when you are done \u2014 nothing here needs it permanently.</string>
	<string name="dns_create_token">Open key settings</string>
	<string name="dns_token_label">Tailnet key</string>
	<string name="dns_token_hint">tskey-api-\u2026</string>
	<string name="dns_token_apply">Connect</string>
	<string name="dns_token_ok">Tailnet connected</string>
	<string name="dns_token_bad">Couldn\u2019t connect: %1$s</string>
	<string name="dns_token_empty">Paste a tailnet key first</string>
	<string name="dns_connected_as">Connected to %1$s</string>
	<string name="dns_connected_named">Encrypted with a key in this phone\u2019s keystore. Revoke it any time in the console.</string>
	<string name="dns_disconnect">Disconnect tailnet</string>
	<string name="dns_disconnect_sub">Forget the tailnet key on this phone. DNS settings stay as they are.</string>
	<string name="dns_disconnect_done">Tailnet disconnected</string>
	<string name="dns_disconnect_title">Disconnect tailnet?</string>
	<string name="dns_disconnect_body">The key is removed from this phone and the DNS controls lock again. Nothing in your tailnet changes.</string>

