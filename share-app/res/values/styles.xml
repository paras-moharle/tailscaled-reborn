<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="Theme.Share" parent="@android:style/Theme.Material.NoActionBar">
		<item name="android:windowBackground">@color/bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlActivated">@color/accent</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@color/bg</item>
		<item name="android:windowLightStatusBar">false</item>
	</style>

	<!-- Dialogs use the app's own surface and outline so they do not read as a
	     different, older dialog dropped on top of a modern screen. -->
	<style name="Theme.Share.Dialog" parent="@android:style/Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlActivated">@color/accent</item>
		<item name="android:backgroundDimAmount">0.72</item>
		<item name="android:textColorPrimary">@color/text</item>
		<item name="android:textColorSecondary">@color/text2</item>
		<!-- Buttons: primary action in accent, Cancel de-emphasised in grey,
		     sentence case so they read as words not shouted labels. -->
		<item name="android:buttonBarPositiveButtonStyle">@style/Button.Dialog.Positive</item>
		<item name="android:buttonBarNegativeButtonStyle">@style/Button.Dialog.Negative</item>
		<item name="android:buttonBarNeutralButtonStyle">@style/Button.Dialog.Negative</item>
	</style>

	<style name="Button.Dialog.Positive" parent="@android:style/Widget.Material.Button.Borderless">
		<item name="android:textColor">@color/accent</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">14.5sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="Button.Dialog.Negative" parent="@android:style/Widget.Material.Button.Borderless">
		<item name="android:textColor">@color/hint</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">14.5sp</item>
		<item name="android:textStyle">normal</item>
	</style>

	<!-- ── type scale ──────────────────────────────────────────

	     The styles are named Text.Something, so they all inherit from this
	     one. It carries the two things every piece of text in the app
	     shares: the colour, and no extra padding above and below the
	     glyphs, which is what makes a screen look set rather than
	     typeset.
	     Three sizes do almost all the work: a row's title, a row's
	     explanation, and the small label that names a group of rows.
	     Keeping the set that small is what makes a screen look designed
	     rather than assembled. -->

	<style name="Text">
		<item name="android:textColor">@color/text</item>
		<item name="android:includeFontPadding">false</item>
	</style>


	<!-- The state of the daemon, at the top of every screen. -->
	<style name="Text.Status">
		<item name="android:textSize">25sp</item>
		<item name="android:textColor">@color/text</item>
		<item name="android:letterSpacing">-0.015</item>
		<item name="android:textStyle">bold</item>
	</style>

	<!-- The line under the status: the host and the version. -->
	<style name="Text.StatusSub">
		<item name="android:textSize">13sp</item>
		<item name="android:textColor">@color/text2</item>
	</style>

	<!-- A row's title. -->
	<style name="Text.RowTitle">
		<item name="android:textSize">15sp</item>
		<item name="android:textColor">@color/text</item>
	</style>

	<!-- A row's explanation. -->
	<style name="Text.RowSub">
		<item name="android:textSize">12.5sp</item>
		<item name="android:textColor">@color/text2</item>
	</style>

	<!-- The name of a group of rows. Small, wide, and quiet, so it labels
	     without competing with what it labels. -->
	<style name="Text.Section">
		<item name="android:textSize">11sp</item>
		<item name="android:textColor">@color/hint</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textAllCaps">true</item>
		<item name="android:letterSpacing">0.1</item>
	</style>

	<!-- The text of a note under a group. -->
	<style name="Text.Note">
		<item name="android:textSize">12.5sp</item>
		<item name="android:textColor">@color/hint</item>
	</style>

	<!-- ── bottom nav ───────────────────────────────────────────── -->
	<!-- The item itself has no background.

	     The default selectableItemBackground is a rectangle the size of the
	     whole item, so pressing one put a square shadow across the bar. The
	     touch feedback belongs on the mark behind the icon, which is the
	     shape of the thing being pressed. -->
	<style name="Nav">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_weight">1</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:orientation">vertical</item>
		<item name="android:gravity">center</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
	</style>

	<!-- The mark behind the selected tab's icon. -->
	<style name="NavPill">
		<item name="android:layout_width">56dp</item>
		<item name="android:layout_height">30dp</item>
	</style>

	<style name="NavIcon">
		<item name="android:layout_width">23dp</item>
		<item name="android:layout_height">23dp</item>
	</style>

	<style name="NavLabel">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">5dp</item>
		<item name="android:textSize">10.5sp</item>
		<item name="android:textColor">@color/hint</item>
		<item name="android:singleLine">true</item>
	</style>

</resources>
