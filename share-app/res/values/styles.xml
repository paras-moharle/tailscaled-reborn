<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!--
	  Two themes, chosen at runtime before the layout is inflated. Material 3
	  is a light-first design, but this app is a daemon console that is mostly
	  used at night, so dark is the one the system usually selects and the one
	  the palette is tuned for.

	  The colours in values/colors.xml are only a first-frame fallback: Theme
	  replaces every role with a generated Material You palette in onCreate.
	-->
	<style name="Theme.Share" parent="Theme.Share.Light" />

	<style name="Theme.Share.Dark" parent="@android:style/Theme.Material.NoActionBar">
		<item name="android:windowBackground">@color/bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlActivated">@color/accent</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@color/bg</item>
		<item name="android:windowLightStatusBar">false</item>
		<item name="android:windowLightNavigationBar">false</item>
		<item name="android:fontFamily">@font/outfit</item>
	</style>

	<style name="Theme.Share.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
		<item name="android:windowBackground">#FFF7F9FC</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlActivated">@color/accent</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">#FFF7F9FC</item>
		<item name="android:windowLightStatusBar">true</item>
		<item name="android:windowLightNavigationBar">true</item>
		<item name="android:fontFamily">@font/outfit</item>
	</style>

	<!-- ── type scale ──────────────────────────────────────────

	     Material 3 names five roles; three are enough here: a display line
	     for the daemon state, a title for a card row, and a body/label pair
	     for everything else. Keeping the set small is what makes a screen
	     look designed rather than assembled. -->

	<style name="Text">
		<item name="android:textColor">@color/text</item>
		<item name="android:includeFontPadding">false</item>
	</style>

	<!-- Display small: the daemon state, the first thing on the page. -->
	<style name="Text.Status">
		<item name="android:textSize">26sp</item>
		<item name="android:textColor">@color/text</item>
		<item name="android:letterSpacing">-0.03</item>
		<item name="android:textStyle">bold</item>
	</style>

	<!-- The category above the display line: small, tracked, coloured. -->
	<style name="Text.Eyebrow">
		<item name="android:textSize">10.5sp</item>
		<item name="android:textColor">@color/accent</item>
		<item name="android:letterSpacing">0.16</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textAllCaps">true</item>
	</style>

	<!-- Body small: the host and the version under it. -->
	<style name="Text.StatusSub">
		<item name="android:textSize">12.5sp</item>
		<item name="android:textColor">@color/text2</item>
		<item name="android:letterSpacing">0.01</item>
	</style>

	<!-- ── bottom navigation ───────────────────────────────────── -->
	<!-- MD3: the item is a column, and the mark behind the icon is a
	     64x32dp pill. The pill is shared and slides, so the item itself only
	     holds the icon and label; its background is the press layer. -->
	<style name="Nav">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_weight">1</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:orientation">vertical</item>
		<item name="android:gravity">center</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
		<item name="android:paddingTop">8dp</item>
		<item name="android:paddingBottom">8dp</item>
	</style>

	<style name="NavPill">
		<item name="android:layout_width">64dp</item>
		<item name="android:layout_height">32dp</item>
	</style>

	<style name="NavIcon">
		<item name="android:layout_width">24dp</item>
		<item name="android:layout_height">24dp</item>
	</style>

	<style name="NavLabel">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">5dp</item>
		<item name="android:textSize">11.5sp</item>
		<item name="android:letterSpacing">0.01</item>
		<item name="android:textColor">@color/hint</item>
		<item name="android:singleLine">true</item>
	</style>

</resources>
