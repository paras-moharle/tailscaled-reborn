<?xml version="1.0" encoding="utf-8"?>
<!--
  Outfit, by the Outfit Project Authors, SIL Open Font License 1.1.

  One family with five real weights. Bundling the files rather than adding a
  downloadable-font provider means the typeface is present on a device that
  has never seen the network, and the display type is identical in light and
  dark. The weights are declared here so `textStyle="bold"` resolves to the
  700 cut instead of the platform synthesising one from 400.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
	<font
		android:font="@font/outfit_light"
		android:fontStyle="normal"
		android:fontWeight="300" />
	<font
		android:font="@font/outfit_regular"
		android:fontStyle="normal"
		android:fontWeight="400" />
	<font
		android:font="@font/outfit_medium"
		android:fontStyle="normal"
		android:fontWeight="500" />
	<font
		android:font="@font/outfit_semibold"
		android:fontStyle="normal"
		android:fontWeight="600" />
	<font
		android:font="@font/outfit_bold"
		android:fontStyle="normal"
		android:fontWeight="700" />
</font-family>
