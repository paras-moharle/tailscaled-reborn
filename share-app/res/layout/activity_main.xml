<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@drawable/bg_app">

	<!--── header: one title line, nothing more ─────────────────
	     The top padding here is only a floor. The real status-bar inset is
	     added at runtime, because a fixed value is either cramped under a
	     tall status bar or wasteful under a short one, and it is measured
	     per device rather than guessed. -->
	<LinearLayout
		android:id="@+id/header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingStart="22dp"
		android:paddingEnd="14dp"
		android:paddingTop="22dp"
		android:paddingBottom="14dp">

		<!-- The status light.

		     A bare dot on a black page is very small and very easy to miss.
		     A disc of the same colour at a low alpha behind it reads as a
		     light rather than a speck. -->
		<FrameLayout
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:layout_marginEnd="12dp">

			<View
				android:id="@+id/dotHalo"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:background="@drawable/dot_halo" />

			<View
				android:id="@+id/dot"
				android:layout_width="9dp"
				android:layout_height="9dp"
				android:layout_gravity="center"
				android:background="@drawable/dot" />
		</FrameLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/status"
				style="@style/Text.Status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:singleLine="true"
				android:ellipsize="end"
				android:text="@string/loading" />

			<TextView
				android:id="@+id/version"
				style="@style/Text.StatusSub"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="3dp"
				android:singleLine="true"
				android:ellipsize="end" />
		</LinearLayout>

		<!--Manual refresh. Peer presence in particular can change without
		     anything on screen moving, and the poll interval is long enough
		     that waiting for it feels like the app is stuck. -->
		<ImageView
			android:id="@+id/refresh"
			android:layout_width="42dp"
			android:layout_height="42dp"
			android:padding="11dp"
			android:layout_gravity="center_vertical"
			android:src="@drawable/ic_refresh"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/refresh" />

	</LinearLayout>

	<!-- ── content ─────────────────────────────────────────────── -->
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<!--Pull-to-refresh indicator. Hidden until a drag starts, and it is
		     the only thing that tells you the gesture was recognised. Without
		     it, pulling down just drags the list and feels like nothing. -->
		<ImageView
			android:id="@+id/pullSpinner"
			android:layout_width="26dp"
			android:layout_height="26dp"
			android:layout_gravity="top|center_horizontal"
			android:layout_marginTop="12dp"
			android:src="@drawable/ic_refresh"
			android:alpha="0"
			android:visibility="invisible"
			android:contentDescription="@string/refresh" />

		<ScrollView
			android:id="@+id/scrollSend"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none">

			<LinearLayout
				android:id="@+id/pSend"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>


		<ScrollView
			android:id="@+id/scrollSettings"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/pSettings"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>

		<ScrollView
			android:id="@+id/scrollSystem"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/pSystem"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>

		<ScrollView
			android:id="@+id/scrollClip"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/pClip"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>

		<!-- The two actions this screen has, floating over the list.

		     The list is the point of the screen, so the buttons are moved
		     out of the flow and into the corner. They are hidden on the
		     other tabs. -->
		<LinearLayout
			android:id="@+id/clipActions"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|end"
			android:orientation="vertical"
			android:gravity="end"
			android:layout_marginEnd="18dp"
			android:layout_marginBottom="18dp"
			android:visibility="gone">

			<ImageView
				android:id="@+id/clipNowFab"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:background="@drawable/fab_secondary"
				android:padding="13dp"
				android:src="@drawable/ic_clip"
				android:contentDescription="@string/clip_now" />

			<ImageView
				android:id="@+id/clipSendFab"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:layout_marginTop="12dp"
				android:background="@drawable/fab"
				android:padding="15dp"
				android:src="@drawable/ic_send"
				android:contentDescription="@string/clip_send_all" />
		</LinearLayout>
	</FrameLayout>

	<!-- ── nav: a floating bar, with the selected tab marked ──
	     A bar that runs edge to edge on a black page is just a band of
	     slightly less black. Floating it with a margin and rounding its
	     ends makes it read as a control sitting on the page, and the
	     selected tab gets a mark behind its icon so the eye can find it
	     without reading the labels. -->
	<LinearLayout
		android:id="@+id/navBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:background="@drawable/nav_bar"
		android:paddingTop="8dp"
		android:paddingBottom="8dp"
		android:layout_marginStart="14dp"
		android:layout_marginEnd="14dp"
		android:layout_marginBottom="12dp">

		<LinearLayout
			android:id="@+id/navSend"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_send" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_send" />
		</LinearLayout>


		<LinearLayout
			android:id="@+id/navSettings"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_settings" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_settings" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/navSystem"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_system" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_system" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/navClip"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_clip" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_clip" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>