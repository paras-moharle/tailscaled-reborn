<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/bg">

	<!--── header: one title line, nothing more ─────────────────
	     The top padding here is only a floor. The real status-bar inset is
	     added at runtime, because a fixed value is either cramped under a
	     tall status bar or wasteful under a short one, and it is measured
	     per device rather than guessed. -->
	<LinearLayout
		android:id="@+id/header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingStart="22dp"
		android:paddingEnd="14dp"
		android:paddingTop="22dp"
		android:paddingBottom="14dp">

		<!-- The status light.

		     A bare dot on a black page is very small and very easy to miss.
		     A tinted tile behind it reads as a light rather than a speck,
		     and gives the header a coloured anchor at the same time. -->
		<FrameLayout
			android:id="@+id/dotTile"
			android:layout_width="42dp"
			android:layout_height="42dp"
			android:layout_marginEnd="14dp">

			<View
				android:id="@+id/dotHalo"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@drawable/dot_halo" />

			<View
				android:id="@+id/dot"
				android:layout_width="10dp"
				android:layout_height="10dp"
				android:layout_gravity="center"
				android:background="@drawable/dot" />
		</FrameLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/eyebrow"
				style="@style/Text.Eyebrow"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/app_name" />

			<TextView
				android:id="@+id/status"
				style="@style/Text.Status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="1dp"
				android:singleLine="true"
				android:ellipsize="end"
				android:text="@string/loading" />

			<TextView
				android:id="@+id/version"
				style="@style/Text.StatusSub"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="3dp"
				android:singleLine="true"
				android:ellipsize="end" />
		</LinearLayout>

		<!--Manual refresh. Peer presence in particular can change without
		     anything on screen moving, and the poll interval is long enough
		     that waiting for it feels like the app is stuck. -->
		<ImageView
			android:id="@+id/refresh"
			android:layout_width="46dp"
			android:layout_height="46dp"
			android:padding="12dp"
			android:layout_marginStart="8dp"
			android:layout_gravity="center_vertical"
			android:src="@drawable/ic_refresh"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/refresh" />

	</LinearLayout>

	<!-- ── content ─────────────────────────────────────────────── -->
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<!--Pull-to-refresh indicator. Hidden until a drag starts, and it is
		     the only thing that tells you the gesture was recognised. Without
		     it, pulling down just drags the list and feels like nothing. -->
		<ImageView
			android:id="@+id/pullSpinner"
			android:layout_width="26dp"
			android:layout_height="26dp"
			android:layout_gravity="top|center_horizontal"
			android:layout_marginTop="12dp"
			android:src="@drawable/ic_refresh"
			android:alpha="0"
			android:visibility="invisible"
			android:contentDescription="@string/refresh" />

		<ScrollView
			android:id="@+id/scrollSend"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none">

			<LinearLayout
				android:id="@+id/pSend"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>


		<ScrollView
			android:id="@+id/scrollDns"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/pDns"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>

		<ScrollView
			android:id="@+id/scrollSettings"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/pSettings"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>

		<ScrollView
			android:id="@+id/scrollSystem"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/pSystem"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingBottom="96dp" />
		</ScrollView>

	</FrameLayout>

	<!-- ── navigation: the Material 3 bottom bar ────────────────
	     A bar that runs edge to edge on a black page used to read as just a
	     slightly lighter band, so it was floated with margins. Material 3
	     solves the same problem differently: a full-width surface container
	     separated by a hairline, with a 64x32dp indicator behind the current
	     item. The indicator is the thing that moves, not the whole bar. -->
	<LinearLayout
		android:id="@+id/navBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginEnd="14dp"
		android:layout_marginBottom="10dp"
		android:orientation="horizontal"
		android:background="@drawable/nav_bar"
		android:elevation="3dp"
		android:paddingTop="7dp"
		android:paddingBottom="7dp"
		android:paddingStart="8dp"
		android:paddingEnd="8dp">

		<LinearLayout
			android:id="@+id/navSend"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_send" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_send" />
		</LinearLayout>


		<LinearLayout
			android:id="@+id/navDns"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_globe" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_dns" />
		</LinearLayout>


		<LinearLayout
			android:id="@+id/navSettings"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_settings" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_settings" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/navSystem"
			style="@style/Nav">

			<FrameLayout
				style="@style/NavPill"
				android:background="@drawable/nav_pill_ripple"
				android:clickable="false"
				android:focusable="false">

				<View
					android:id="@+id/navPill"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="@drawable/nav_pill"
					android:visibility="invisible" />

				<ImageView
					android:id="@+id/navIcon"
					style="@style/NavIcon"
					android:layout_gravity="center"
					android:src="@drawable/ic_system" />
			</FrameLayout>

			<TextView
				android:id="@+id/navLabel"
				style="@style/NavLabel"
				android:text="@string/nav_system" />
		</LinearLayout>

	</LinearLayout>
</LinearLayout>