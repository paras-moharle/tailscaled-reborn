<?xml version="1.0" encoding="utf-8"?>
<!-- The one primary action.

     A gradient rather than a flat fill: a single flat colour on a black page
     reads as a slab, and a slight fall-off from top to bottom gives it the
     same sense of a lit surface as the cards. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_pressed="true">
		<shape android:shape="rectangle">
			<gradient android:angle="270"
				android:startColor="#FF2E7BE8" android:endColor="#FF1F63CE" />
			<corners android:radius="16dp" />
		</shape>
	</item>
	<item android:state_enabled="false">
		<shape android:shape="rectangle">
			<solid android:color="@color/surfaceHi" />
			<corners android:radius="16dp" />
			<stroke android:width="1dp" android:color="@color/hairline" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<gradient android:angle="270"
				android:startColor="@color/accentHi" android:endColor="@color/accent" />
			<corners android:radius="16dp" />
		</shape>
	</item>
</selector>
