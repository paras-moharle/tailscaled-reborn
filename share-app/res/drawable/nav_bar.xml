<?xml version="1.0" encoding="utf-8"?>
<!-- The navigation bar: a floating bar rather than a strip along the edge.

     On black, a bar that goes edge to edge is just a band of slightly less
     black. Floating it with a margin and rounding its ends makes it read as
     a control sitting on the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
	<solid android:color="#FF0D1116" />
	<corners android:radius="28dp" />
	<stroke android:width="1dp" android:color="@color/hairline" />
</shape>
