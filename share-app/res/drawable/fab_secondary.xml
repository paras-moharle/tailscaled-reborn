<?xml version="1.0" encoding="utf-8"?>
<!-- The second floating button: the same shape, but it is a lesser action,
     so it is drawn in the surface colour with a hairline rather than in
     the accent. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="#22FFFFFF">
	<item>
		<shape android:shape="oval">
			<solid android:color="@color/surfaceTop" />
			<stroke android:width="1dp" android:color="@color/hairline" />
		</shape>
	</item>
</ripple>
