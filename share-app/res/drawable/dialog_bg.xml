<?xml version="1.0" encoding="utf-8"?>
<!-- The sheet every dialog in the app sits on.

	 Raised one step above the page surface (surfaceTop), with the widest
	 corners the app uses: a dialog is lifted higher than a card, and its
	 corners show it. The outline is the hairline white the app carries
	 everywhere, so the edge reads as a boundary of light rather than as a
	 drawn stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
	<solid android:color="@color/surfaceTop" />
	<corners android:radius="22dp" />
	<stroke android:width="1dp" android:color="@color/hairline" />
</shape>
