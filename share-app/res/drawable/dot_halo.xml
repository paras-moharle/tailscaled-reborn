<?xml version="1.0" encoding="utf-8"?>
<!-- The soft glow behind the status dot.

     A bare dot on black is very small and very easy to miss. A disc of the
     same colour at a low alpha behind it reads as a light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
	<solid android:color="@color/hint" />
</shape>
