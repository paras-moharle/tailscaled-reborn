#!/usr/bin/env bash
# taildrop-receiver — collect Taildrop deliveries into a folder, automatically.
#
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 paras-moharle
#
# ── Why this fetches at all ─────────────────────────────────────────────────
#
# Linux and Android tailscaled do not agree about Taildrop.
#
# On Android the daemon writes each delivery straight into the download folder
# and there is nothing to fetch. On Linux the delivery is held by the daemon:
# `tailscale file get` collects it, and `tailscale file cp` returns success the
# entire time without delivering anything. A receiver that waits to be handed
# the file, the way the phone's does, therefore waits forever on Linux.
#
# ── Why it waits instead of polling ─────────────────────────────────────────
#
# `tailscale file get --wait` blocks until a delivery arrives and then returns.
# That is event-driven: no five-second sleep between a send happening and the
# file being collected, and no subprocess started every few seconds for the
# whole login session.
#
# The shape follows Omarchy's own receiver, which is the reference here: fetch
# with --wait, move everything that landed in staging, then wait again. What
# this adds is that the destination is Downloads/Tailscale rather than loose in
# Downloads, and that the outcome of each arrival is logged.
#
# ── Why staging, and why presence is the whole test ────────────────────────
#
# Deliveries are fetched into a directory this owns. Each file is moved out of
# it as it is collected, so anything still in staging is by definition not
# delivered yet and there is nothing to track.
#
# A seen-list keyed on filename was tried and was wrong: once a name had been
# seen, every later delivery of that name was skipped forever, so sending the
# same file twice silently stopped working. Keying on size and mtime did not
# help either, because re-sending the same file produces identical bytes with
# the same timestamp.
set -uo pipefail

DEST="${TAILDROP_DEST:-$HOME/Downloads/Tailscale}"
STATE_DIR="${TAILDROP_STATE:-$HOME/.local/state/taildrop-receiver}"
STAGING="${TAILDROP_STAGING:-$STATE_DIR/staging}"
STUCK_FILE="$STATE_DIR/stuck.list"
FETCH_LOG="$STATE_DIR/fetch.log"
CLI="${TAILDROP_CLI:-tailscale}"

# Logs go to stderr, never stdout.
#
# deliver() is invoked as `_n="$(deliver)"` to read back how many files it
# moved, and stdout is the only channel that survives a command substitution.
# Logging to stdout therefore fed the log lines into that variable, so the
# count came out as a timestamp: "[: <log line>: integer expected", once per
# file, in the journal, for every arrival.
log() { printf '%s taildrop-receiver: %s\n' "$(date -Is)" "$*" >&2; }

if ! command -v "$CLI" >/dev/null 2>&1; then
    log "no '$CLI' on PATH; exiting"
    exit 127
fi

mkdir -p "$DEST" "$STAGING" "$STATE_DIR" || { log "cannot create directories"; exit 1; }

# The daemon may not be up yet at boot, so wait for a usable backend rather
# than spinning against a socket that is not listening.
state=""
for _ in $(seq 1 60); do
    state="$($CLI status --json 2>/dev/null | grep -o '"BackendState": *"[^"]*"' | cut -d'"' -f4)"
    case "$state" in
        Running) break ;;
        NeedsLogin)
            log "tailnet needs login; run 'tailscale up' (or open the app)"
            exit 0
            ;;
    esac
    sleep 2
done

if [ "${state:-}" != "Running" ]; then
    log "daemon not ready (state=${state:-unknown}); exiting"
    exit 1
fi

# Hard links let a name be taken atomically: link(2) fails rather than
# clobbering, so two arrivals wanting the same destination cannot race. It only
# works within one filesystem, so it is probed rather than assumed.
USE_LN=0
: > "$STAGING/.probe" 2>/dev/null
if ln "$STAGING/.probe" "$DEST/.probe" 2>/dev/null; then
    rm -f "$DEST/.probe"
    USE_LN=1
fi
rm -f "$STAGING/.probe"
[ "$USE_LN" -eq 1 ] || log "staging and destination are on different filesystems; using move"

# Move one staged file into DEST, taking a free name atomically.
#
# Only a name that is already taken is worth another attempt. Any other failure
# means the operation itself did not work, and the file keeps its place in
# staging for the next pass rather than being retried under a hundred invented
# names.
claim_path() {
    _staged="$1"
    _name="${_staged##*/}"
    # Keep compound extensions whole: splitting on the last dot alone turned
    # "photos.tar.gz" into "photos.tar-1.gz", which is not a name anybody has.
    _base="$_name"
    _ext=""
    for _c in .tar.gz .tar.bz2 .tar.xz .tar.zst; do
        case "$_name" in
            *"$_c")
                _ext="$_c"
                _base="${_name%"$_c"}"
                break
                ;;
        esac
    done
    if [ -z "$_ext" ]; then
        case "$_name" in
            *.*)
                _ext=".${_name##*.}"
                _base="${_name%.*}"
                ;;
        esac
    fi
    # A dotfile such as ".gitignore" is all extension and no stem; it is one
    # name, and numbering it must not produce "-1.gitignore".
    [ -z "$_base" ] && { _base="$_name"; _ext=""; }

    _i=0
    while [ "$_i" -lt 1000 ]; do
        if [ "$_i" -eq 0 ]; then
            _cand="$DEST/$_name"
        else
            _cand="$DEST/${_base}-${_i}${_ext}"
        fi

        if [ "$USE_LN" -eq 1 ]; then
            if ln -- "$_staged" "$_cand" 2>/dev/null; then
                rm -f -- "$_staged"
                printf '%s' "$_cand"
                return 0
            fi
            [ -e "$_cand" ] || return 1
        else
            if mv -n -- "$_staged" "$_cand" 2>/dev/null; then
                printf '%s' "$_cand"
                return 0
            fi
            [ -e "$_cand" ] || return 1
        fi

        _i=$((_i + 1))
    done
    return 1
}

note_stuck() {
    _n="${1##*/}"
    if [ -f "$STUCK_FILE" ] && grep -Fxq -- "$_n" "$STUCK_FILE" 2>/dev/null; then
        return 0
    fi
    printf '%s\n' "$_n" >> "$STUCK_FILE" 2>/dev/null || true
    log "could not store $_n; it stays in $STAGING"
}

# A clipboard is not a file.
#
# The phone sends the clipboard as a Taildrop file whose first line is the
# magic "TBCLIP1". It is put on the computer's clipboard and then removed:
# what was copied belongs on the clipboard, and the clipboard manager keeps
# its own history of that. Leaving a file behind as well would put the
# same text in two places, and the file would be the one that outlived the
# clipboard.
is_clip() {
    [ -f "$1" ] || return 1
    [ "$(head -1 -- "$1" 2>/dev/null)" = "TBCLIP1" ]
}

# The source a clipboard came from, out of its metadata line.
clip_source() {
    sed -n '2p' -- "$1" 2>/dev/null |
        sed -n 's/.*"s"[ ]*:[ ]*"\([^"]*\)".*/\1/p'
}

# The text of a clipboard, decoded.
clip_text() {
    _b64="$(tail -n +3 -- "$1" 2>/dev/null | tr -d '\n')"
    [ -n "$_b64" ] || return 1
    printf '%s' "$_b64" | base64 -d 2>/dev/null
}

# Put text on the computer's clipboard.
#
# Wayland first, then X11. xclip is told to fork, because the clipboard it
# holds dies with it; wl-copy keeps the selection itself.
set_clipboard() {
    _text="$1"
    [ -n "$_text" ] || return 1
    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$_text" | wl-copy -- 2>/dev/null && return 0
    fi
    if command -v xclip >/dev/null 2>&1; then
        printf '%s' "$_text" | xclip -selection clipboard -in 2>/dev/null && return 0
    fi
    if command -v xsel >/dev/null 2>&1; then
        printf '%s' "$_text" | xsel --clipboard --input 2>/dev/null && return 0
    fi
    return 1
}

# Say that a clipboard arrived.
announce_clip() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Taildrop" -u critical \
            "Clipboard received" "From ${1:-a peer}" >/dev/null 2>&1 || true
    fi
}

# Returns how many files it moved, on stdout.
announce() {
    _path="$1"
    _name="${_path##*/}"
    # Best-effort on purpose: the file is already delivered, and a
    # notification outage must not take the receiver down with it.
    if command -v notify-send >/dev/null 2>&1; then
        if notify-send -a "Taildrop" -u critical \
                "Received $_name" "Saved to ${DEST/#$HOME/~}"; then
            log "notified: $_name"
        else
            log "notify-send failed for $_name (the file was still delivered)"
        fi
    fi
}

deliver() {
    _got=0
    for _staged in "$STAGING"/*; do
        [ -f "$_staged" ] || continue
        # A transfer the daemon has not finished writing is named
        # "<name>.<sender-node-id>[-n].partial". Claiming it announces a
        # truncated send as though it were the file. The daemon writes the real
        # name when the transfer completes, so these are left alone.
        case "${_staged##*/}" in
            *.partial) continue ;;
        esac
        # A clipboard goes on the clipboard.
        if is_clip "$_staged"; then
            _text="$(clip_text "$_staged")"
            if [ -n "$_text" ] && set_clipboard "$_text"; then
                _src="$(clip_source "$_staged")"
                rm -f -- "$_staged"
                log "clipboard received from ${_src:-a peer}"
                # No notification. A clipboard arriving is not news, and a
                # notification for every copy would be a notification for
                # every copy anybody makes. Only a file that was sent gets
                # one.
            else
                log "could not put the clipboard on the computer's clipboard; it stays in $STAGING"
            fi
            continue
        fi
        if _target="$(claim_path "$_staged")" && [ -n "$_target" ]; then
            _got=$((_got + 1))
            log "collected: ${_staged##*/} -> $_target"
            announce "$_target"
        else
            note_stuck "$_staged"
        fi
    done
    printf '%s' "$_got"
}

# Anything staged by an interrupted run still deserves delivering.
deliver >/dev/null

log "watching for Taildrop deliveries into $DEST"

_fetches=0
while :; do
    if timeout 3600 "$CLI" file get --wait --conflict=rename "$STAGING" \
            >>"$FETCH_LOG" 2>&1; then
        _fetches=0
    else
        # A daemon restart or a logout looks like this. Stay up: the whole
        # point is to still be here next time.
        _fetches=$((_fetches + 1))
        if [ "$_fetches" -eq 1 ]; then
            log "fetch returned non-zero; retrying"
        elif [ "$_fetches" -eq 10 ]; then
            log "fetch has failed 10 times in a row; see $FETCH_LOG"
        fi
        sleep 10
        continue
    fi

    _n="$(deliver)"
    # A file that could not be moved is still staged. Retry it on a short
    # cadence instead of leaving it until the next unrelated delivery wakes
    # the loop.
    _tries=0
    while [ "$_n" -eq 0 ] && [ "$_tries" -lt 5 ] &&
            [ -n "$(find "$STAGING" -mindepth 1 -maxdepth 1 -type f -print -quit 2>/dev/null)" ]; do
        _tries=$((_tries + 1))
        sleep 5
        _n="$(deliver)"
    done
done